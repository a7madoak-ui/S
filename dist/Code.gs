>\n        <div class=\"grid-2\">\n          <div class=\"field\"><label class=\"field__label\" for=\"st-name\">اسم المشرف<span class=\"req\" aria-hidden=\"true\">*</span></label><input id=\"st-name\" class=\"input\" maxlength=\"60\" value=\"${su.name || ''}\" autocomplete=\"name\">${fieldError('st-name-err')}</div>\n          <div class=\"field\"><label class=\"field__label\" for=\"st-stitle\">المسمّى</label><input id=\"st-stitle\" class=\"input\" maxlength=\"60\" value=\"${su.title || ''}\" data-input=\"title-chips\">\n            <div class=\"ad-chiprow\" role=\"group\" aria-label=\"مسمّيات مقترحة\">${TITLE_CHIPS.map(function (t) { return html`<button type=\"button\" class=\"ad-chipbtn\" data-action=\"pick-title\" data-target=\"st-stitle\" data-value=\"${t}\" aria-pressed=\"${su.title === t}\">${t}</button>`; })}</div></div>\n          <div class=\"field\"><label class=\"field__label\" for=\"st-office\">الجهة</label><input id=\"st-office\" class=\"input\" maxlength=\"80\" value=\"${su.office || ''}\" placeholder=\"مثال: مكتب التعليم بشمال الرياض\"></div>\n          <div class=\"field\"><label class=\"field__label\" for=\"st-phone\">الجوال</label><input id=\"st-phone\" class=\"input ltr\" dir=\"ltr\" maxlength=\"20\" inputmode=\"tel\" value=\"${su.phone || ''}\" placeholder=\"05xxxxxxxx\">${fieldError('st-phone-err')}</div>\n        </div>\n      </div>`;\n    },\n    g_review: function () {\n      var on = !!(S.settings.review && S.settings.review.enabled);\n      return html`<label class=\"switch ad-switchrow\"><span>تفعيل مراجعة المشرف للتقارير<small>تصل التقارير بحالة «بانتظار المراجعة» لتعتمدها أو تعيدها للتصحيح. عند الإيقاف تُعتمد التقارير تلقائيًا فور إرسالها.</small></span><input type=\"checkbox\" role=\"switch\" id=\"st-review\"${attr(on, 'checked')}></label>`;\n    },\n    g_links: function () {\n      var st = S.settings, on = !!(st.links && st.links.generalEnabled), gl = st.generalLink || generalLink();\n      var detected = st.detectedUrl && st.detectedUrl !== st.webAppUrl ? st.detectedUrl : '';\n      return html`<div class=\"stack\">\n        <label class=\"switch ad-switchrow\"><span>تفعيل الرابط العام لكل المدارس<small>رابط واحد يختار منه المدير مدرسته ويُدخل «رمز المدرسة». عند الإيقاف تعمل الروابط الخاصة فقط — وهي الأدق.</small></span><input type=\"checkbox\" role=\"switch\" id=\"st-general\"${attr(on, 'checked')}></label>\n        ${gl ? html`<div class=\"ad-linkbox\"><span class=\"ad-linkbox__url\">${gl}</span><button type=\"button\" class=\"btn btn-ghost btn-sm\" data-action=\"general-copy\">${icon('copy')}<span>نسخ</span></button></div>` : ''}\n        <div class=\"field ad-urlfield\">\n          <label class=\"field__label\" for=\"st-weburl\">رابط تطبيق الويب (ينتهي بـ \u2066/exec\u2069)</label>\n          <input id=\"st-weburl\" class=\"input\" type=\"url\" inputmode=\"url\" dir=\"ltr\" autocomplete=\"off\" spellcheck=\"false\" maxlength=\"300\" value=\"${st.webAppUrl || ''}\" placeholder=\"https://script.google.com/macros/s/…/exec\">\n          ${fieldError('st-weburl-err')}\n          <p class=\"field__hint\">منه تُبنى روابط المدارس والرابط العام. يُحفظ تلقائيًا عند فتح اللوحة من رابط النشر؛ غيّره فقط إذا أنشأت «نشرًا جديدًا» برابط مختلف (انسخه من «نشر» ← «إدارة عمليات النشر»).</p>\n          ${detected ? html`<div class=\"row mt-1\"><span class=\"text-xs text-muted\">الرابط الذي فتحت منه اللوحة الآن: <bdi dir=\"ltr\">${detected}</bdi></span><button type=\"button\" class=\"btn btn-ghost btn-sm\" data-action=\"use-detected-url\" data-url=\"${detected}\">استخدام هذا الرابط</button></div>` : ''}\n        </div>\n      </div>`;\n    },\n    g_schedule: function () {\n      var sc = S.settings.schedule || {}, wd = sc.workdays || [];\n      return html`<div class=\"stack\">\n        <div class=\"grid-2\"><div class=\"field\"><label class=\"field__label\" for=\"st-deadline\">آخر موعد للإرسال يوميًا</label><input id=\"st-deadline\" class=\"input\" type=\"time\" value=\"${sc.deadline || '09:00'}\" step=\"300\">${fieldError('st-deadline-err')}</div></div>\n        <div class=\"field\"><span class=\"field__label\" id=\"st-wd-l\">أيام الدوام</span>\n          <div class=\"choice-group ad-wd\" role=\"group\" aria-labelledby=\"st-wd-l\" id=\"st-wd\">${[0, 1, 2, 3, 4, 5, 6].map(function (i) { return html`<button type=\"button\" class=\"choice\" data-action=\"toggle-wd\" data-day=\"${i}\" aria-pressed=\"${wd.indexOf(i) >= 0}\">${A.date.dayNames[i]}</button>`; })}</div>\n          ${fieldError('st-wd-err')}</div>\n        <label class=\"switch ad-switchrow\"><span>السماح بالإرسال بعد الموعد<small>يُقبل التقرير ويُعلَّم «متأخر». عند الإيقاف يُغلق النموذج بعد الموعد لمن لم يرسل.</small></span><input type=\"checkbox\" role=\"switch\" id=\"st-late\"${attr(!!sc.allowLate, 'checked')}></label>\n        <div class=\"field\">\n          <label class=\"field__label\" for=\"st-backfill\">السماح بإرسال تقارير الأيام الفائتة حتى</label>\n          <div class=\"ad-unit ad-unit--wide\"><input id=\"st-backfill\" class=\"input\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"7\" step=\"1\" value=\"${isNum(sc.backfillDays) ? sc.backfillDays : 2}\" aria-describedby=\"st-backfill-hint\"><span class=\"ad-unit__suffix\" aria-hidden=\"true\">أيام عمل</span></div>\n          ${fieldError('st-backfill-err')}\n          <p class=\"field__hint\" id=\"st-backfill-hint\">إذا نسيت مدرسة إرسال تقرير يوم دوام، تستطيع إرساله لاحقًا خلال هذه المدة (يُسجَّل «متأخرًا»). 0 = غير مسموح.</p>\n        </div>\n      </div>`;\n    },\n    g_alerts: function () {\n      var a = S.settings.alerts || {};\n      var f = function (id, label, val, min, max, hint) {\n        return html`<div class=\"field\"><label class=\"field__label\" for=\"${id}\">${label}</label><div class=\"ad-unit\"><input id=\"${id}\" class=\"input\" type=\"number\" inputmode=\"numeric\" min=\"${min}\" max=\"${max}\" step=\"1\" value=\"${val}\"><span class=\"ad-unit__suffix\" aria-hidden=\"true\">٪</span></div>${fieldError(id + '-err')}<p class=\"field__hint\">${hint}</p></div>`;\n      };\n      return html`<div class=\"ad-thr\">\n        ${f('st-a-stu', 'حد غياب الطلاب', a.studentAbsencePct, 1, 100, 'تنبيه أحمر عندما تبلغ نسبة غياب الطلاب في مدرسة هذا الحد أو أكثر.')}\n        ${f('st-a-tea', 'حد غياب المعلمين', a.teacherAbsencePct, 1, 100, 'تنبيه عندما تبلغ نسبة غياب المعلمين هذا الحد أو أكثر.')}\n        ${f('st-a-act', 'الحد الأدنى لتفعيل الحصص', a.activationPct, 1, 100, 'تنبيه عندما تقل نسبة الحصص المفعّلة عن هذا الحد.')}\n        ${f('st-a-jump', 'الارتفاع المفاجئ في الغياب', a.jumpPct, 10, 500, 'تنبيه عندما يزيد غياب طلاب مدرسة بهذه النسبة عن متوسط أيامها السابقة.')}\n      </div>`;\n    },\n    tpl: function (id, label, val, phs, hint) {\n      var v = val || '';\n      return html`<div class=\"ad-tpl\"><div class=\"field\">\n        <label class=\"field__label\" for=\"${id}\">${label}</label>\n        <p class=\"field__hint\">${hint}</p>\n        <div class=\"ad-ph\" role=\"group\" aria-label=\"إدراج متغير في الرسالة\">${phs.map(function (p) {\n          var meta = PLACEHOLDERS.filter(function (x) { return x.k === p; })[0];\n          return html`<button type=\"button\" data-action=\"insert-ph\" data-target=\"${id}\" data-ph=\"${p}\" title=\"${meta ? meta.d : ''}\">${p}</button>`;\n        })}</div>\n        <div class=\"ad-tpl__grid\">\n          <textarea id=\"${id}\" class=\"textarea\" rows=\"8\" maxlength=\"600\" data-input=\"tpl-preview\">${v}</textarea>\n          <div><div class=\"ad-msg__hint\">معاينة الرسالة</div><div class=\"ad-msg\" id=\"${id}-pv\">${msgHtml(Settings.sample(v))}</div></div>\n        </div>\n        <div class=\"field__foot\"><button type=\"button\" class=\"ad-linkish\" data-action=\"tpl-reset\" data-target=\"${id}\">استعادة النص الافتراضي</button><span class=\"field__count\" id=\"${id}-cnt\">${v.length} / 600</span></div>\n      </div></div>`;\n    },\n    sample: function (tpl) {\n      var s = (S.schools || []).filter(function (x) { return x.active; })[0] || { name: 'مدرسة النور الابتدائية', pin: '4821', link: '' };\n      return A.fillTemplate(tpl, { school: s.name, link: s.link || (baseUrl() ? baseUrl() + '?s=…' : 'https://script.google.com/…'), supervisor: supSig() || 'المشرف التربوي / اسمك', date: dateMsg(todayISO()), note: 'يرجى مراجعة عدد الغائبين من الطلاب', pin: s.pin || '4821' }) || '—';\n    },\n    preview: function (el) {\n      var pv = byId(el.id + '-pv'), cnt = byId(el.id + '-cnt');\n      if (pv) setHtml(pv, html`${msgHtml(Settings.sample(el.value))}`);\n      if (cnt) { cnt.textContent = el.value.length + ' / 600'; cnt.classList.toggle('is-near', el.value.length >= 520); }\n    },\n    g_messages: function () {\n      var s = S.settings;\n      return html`${Settings.tpl('st-msg', 'رسالة إرسال الرابط والتذكير', s.messageTemplate, ['{المدرسة}', '{الرابط}', '{المشرف}', '{التاريخ}', '{الرمز}'], 'تُستخدم عند إرسال روابط المدارس والتذكير بالتقرير اليومي.')}\n        ${Settings.tpl('st-ret', 'رسالة الإعادة للتصحيح', s.returnTemplate, ['{المدرسة}', '{التاريخ}', '{الملاحظة}', '{الرابط}', '{المشرف}'], 'تُعرض عليك بعد إعادة تقرير للتصحيح لإبلاغ المدرسة.')}`;\n    },\n    g_holidays: function () {\n      var t = todayISO();\n      return html`<div class=\"stack\">\n        <div class=\"ad-hadd\">\n          <div class=\"field\"><label class=\"field__label\" for=\"st-h-from\">من تاريخ</label><input type=\"date\" id=\"st-h-from\" class=\"input\" min=\"${A.date.add(t, -365)}\" max=\"${A.date.add(t, 400)}\"></div>\n          <div class=\"field\"><label class=\"field__label\" for=\"st-h-to\">إلى تاريخ <span class=\"text-muted fw-500\">(اختياري)</span></label><input type=\"date\" id=\"st-h-to\" class=\"input\" min=\"${A.date.add(t, -365)}\" max=\"${A.date.add(t, 400)}\"></div>\n          <button type=\"button\" class=\"btn btn-secondary\" data-action=\"holiday-add\">${icon('plus')}<span>إضافة</span></button>\n        </div>\n        <p class=\"field__hint\">لا يُنتظر إرسال التقارير في أيام الإجازة، ولا تُحسب في الالتزام بالتسليم. عند اختيار فترة تُضاف أيام الدوام فيها فقط.</p>\n        <div id=\"st-hlist\"></div>\n      </div>`;\n    },\n    hlist: function () {\n      var el = byId('st-hlist');\n      if (!el) return;\n      var t = todayISO(), list = (S.setDraft.holidays || []).slice().sort();\n      var up = list.filter(function (d) { return d >= t; }), past = list.filter(function (d) { return d < t; }).reverse();\n      var chip = function (d) { return html`<span class=\"ad-hday${d < t ? ' is-past' : ''}\"><span>${A.date.dayName(d)} ${A.date.greg(d)}</span><button type=\"button\" data-action=\"holiday-del\" data-date=\"${d}\" aria-label=\"${'حذف إجازة ' + dateMsg(d)}\">${icon('x')}</button></span>`; };\n      setHtml(el, html`${up.length ? html`<div class=\"ad-hdays\">${up.map(chip)}</div>` : html`<p class=\"text-sm text-muted\">لا توجد إجازات قادمة مسجّلة.</p>`}\n        ${past.length ? html`<div class=\"mt-3\"><button type=\"button\" class=\"ad-linkish\" data-action=\"holidays-past\">${S.setDraft.showPast ? 'إخفاء الإجازات السابقة' : 'عرض الإجازات السابقة (' + past.length + ')'}</button>${S.setDraft.showPast ? html`<div class=\"ad-hdays mt-2\">${past.map(chip)}</div>` : ''}</div>` : ''}`);\n    },\n    g_digest: function () {\n      var dg = S.settings.digest || {};\n      return html`<div class=\"stack\">\n        <label class=\"switch ad-switchrow\"><span>إرسال ملخص يومي إلى بريدي<small>يصلك في أيام الدوام: من أرسل ومن لم يرسل، وما ينتظر مراجعتك، والتنبيهات.</small></span><input type=\"checkbox\" role=\"switch\" id=\"st-digest\"${attr(!!dg.enabled, 'checked')}></label>\n        <div class=\"grid-2\">\n          <div class=\"field\"><label class=\"field__label\" for=\"st-digest-time\">وقت الإرسال</label><input type=\"time\" id=\"st-digest-time\" class=\"input\" value=\"${dg.time || '10:00'}\" step=\"300\">${fieldError('st-digest-time-err')}\n            <small class=\"field__hint\">قد يصل قبل الوقت المختار أو بعده بربع ساعة تقريبًا (توقيت Google). لمعرفة من تأخّر، اختر وقتًا بعد 