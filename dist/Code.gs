ted fw-500\">(اختياري)</span></legend>\n            <div class=\"grid-3 ad-counts\">${cnt('students', 'عدد الطلاب')}${cnt('teachers', 'عدد المعلمين')}${cnt('staff', 'عدد الإداريين')}</div>\n            <p class=\"field__hint\">تُستخدم لتعبئة «الحاضرون» تلقائيًا في نموذج المدرسة، ولتنبيه المدير عند اختلاف المجموع.</p>\n          </fieldset>\n          <button type=\"submit\" hidden></button>\n        </form>`,\n        foot: html`<button type=\"button\" class=\"btn btn-primary\" data-action=\"school-save\">${icon('check')}<span>${isNew ? 'إضافة المدرسة' : 'حفظ التغييرات'}</span></button><button type=\"button\" class=\"btn btn-secondary\" data-modal-close>إلغاء</button>`,\n        onClose: function () { SchoolEdit.cur = null; }\n      });\n    },\n    save: function (btn) {\n      var form = byId('se-form');\n      if (!form || !SchoolEdit.cur) return;\n      clearErrors(form);\n      var val = function (id) { return (byId(id).value || '').trim(); };\n      var data = { name: val('se-name').replace(/\\s+/g, ' '), stage: val('se-stage'), ministryNo: digits(val('se-min')) || val('se-min'), principal: val('se-principal'), phone: A.latinDigits(val('se-phone')).replace(/[\\s-]/g, '') };\n      var bad = null;\n      if (data.name.length < 2) { setFieldError(byId('se-name'), 'اكتب اسم المدرسة (حرفان على الأقل).'); bad = bad || byId('se-name'); }\n      if (data.ministryNo.length > 20) { setFieldError(byId('se-min'), 'الرقم الوزاري أطول من 20 خانة.'); bad = bad || byId('se-min'); }\n      if (data.phone && !/^\\+?\\d{6,15}$/.test(data.phone)) { setFieldError(byId('se-phone'), 'رقم الجوال غير صحيح. اكتب الأرقام فقط (مثل 0501234567).'); bad = bad || byId('se-phone'); }\n      var dup = (S.schools || []).filter(function (s) { return s.id !== SchoolEdit.cur.id && normAr(s.name) === normAr(data.name); })[0];\n      if (dup && !bad) { setFieldError(byId('se-name'), 'توجد مدرسة بالاسم نفسه. اختر اسمًا مختلفًا.'); bad = byId('se-name'); }\n      ['students', 'teachers', 'staff'].forEach(function (k) {\n        var raw_ = digits(byId('se-' + k).value);\n        var n = raw_ === '' ? 0 : parseInt(raw_, 10);\n        if (!(n >= 0 && n <= 100000)) { setFieldError(byId('se-' + k), 'رقم من 0 إلى 100000.'); bad = bad || byId('se-' + k); }\n        data[k] = n;\n      });\n      if (bad) { bad.focus(); return; }\n      if (SchoolEdit.cur.id) data.id = SchoolEdit.cur.id;\n      var isNew = !data.id;\n      return A.busy(btn, auth('api_saveSchool', data)).then(function (r) {\n        closeTopModal();\n        flashRow(r.school.id);\n        upsertSchool(r.school);\n        if (S.view === 'schools') Schools.paintList();\n        A.toast(isNew ? 'تمت إضافة «' + r.school.name + '» — أرسل رابطها للمدير من زر واتساب' : 'تم حفظ بيانات «' + r.school.name + '»');\n      }, function (e) {\n        if (/الاسم نفسه|اسم المدرسة/.test(errText(e))) { setFieldError(byId('se-name'), errText(e)); byId('se-name').focus(); return; }\n        if (/الجوال/.test(errText(e))) { setFieldError(byId('se-phone'), errText(e)); return; }\n        fail(e);\n      });\n    }\n  };\n\n  /* --- bulk add */\n  var Bulk = {\n    open: function () {\n      openModal({\n        title: 'إضافة عدة مدارس', size: 'md', className: 'ad-bulk-modal',\n        body: Bulk.formHtml(''),\n        foot: Bulk.formFoot(),\n        onClose: function () { if (S.view === 'schools') Schools.paintList(); }\n      });\n      Bulk.count();\n    },\n    formHtml: function (text) {\n      return html`<div class=\"stack\" id=\"bk-wrap\">\n        <div class=\"field\">\n          <label class=\"field__label\" for=\"bk-text\">المدارس — سطر لكل مدرسة</label>\n          <textarea id=\"bk-text\" class=\"textarea\" rows=\"9\" data-input=\"bulk-count\" placeholder=\"اكتب اسم كل مدرسة في سطر&#10;مثال:&#10;مدرسة النور الابتدائية، أ. خالد العتيبي، 0501234567، 400، 30، 8&#10;متوسطة الفجر\">${text}</textarea>\n          <div class=\"field__foot\"><span class=\"field__hint\">حتى 200 مدرسة في المرة الواحدة.</span><span class=\"field__count fw-600\" id=\"bk-count\" aria-live=\"polite\"></span></div>\n        </div>\n        <div class=\"ad-muted-box\">${icon('info', 18)} بعد الاسم يمكنك إضافة (اختياريًا) مفصولة بفاصلة: <strong>اسم المدير، الجوال، عدد الطلاب، عدد المعلمين، عدد الإداريين</strong>. يمكنك النسخ من Excel مباشرة، والمدارس المكررة تُتجاهل تلقائيًا.</div>\n      </div>`;\n    },\n    formFoot: function () {\n      return html`<button type=\"button\" class=\"btn btn-primary\" data-action=\"bulk-save\">${icon('plus')}<span>إضافة المدارس</span></button><button type=\"button\" class=\"btn btn-secondary\" data-modal-close>إلغاء</button>`;\n    },\n    count: function () {\n      var el = byId('bk-text'), out = byId('bk-count');\n      if (!el || !out) return;\n      var p = parseBulk(el.value, (S.schools || []).map(function (s) { return s.name; }));\n      var dup = p.skipped.filter(function (s) { return s.reason === 'مكررة'; }).length;\n      out.textContent = p.items.length ? 'سيتم إضافة ' + pluralG(p.items.length, P_SCHOOL) + (dup ? ' (' + dup + ' مكررة)' : '') : (dup ? dup + ' مكررة' : '');\n    },\n    save: function (btn) {\n      var el = byId('bk-text');\n      if (!el) return;\n      var text = el.value;\n      if (!text.trim()) { setFieldError(el, 'اكتب اسم مدرسة واحدة على الأقل.'); el.focus(); return; }\n      var lines = text.replace(/\\r\\n?/g, '\\n').split('\\n');\n      return A.busy(btn, auth('api_bulkAddSchools', text)).then(function (r) {\n        var m = A.modal.top();\n        if (!m || !m.el.classList.contains('ad-bulk-modal')) return;\n        var skipped = r.skipped || [];\n        m.setBody(html`<div class=\"ad-bulk-result\">\n          <div class=\"alert ${r.added ? 'alert--ok' : 'alert--warn'}\">${icon(r.added ? 'check' : 'info')}<div><span class=\"alert__title\">${r.added ? 'أُضيفت ' + plural(r.added, P_SCHOOL) : 'لم تُضف مدارس جديدة'}</span>${r.added ? 'لكل مدرسة رابط خاص ورمز — أرسل الروابط من زر «إرسال الروابط».' : ''}</div></div>\n          ${skipped.length ? html`<div><h4 class=\"mb-1\">لم تُضف (${skipped.length}):</h4><ul>${skipped.map(function (s) {\n            var ln = bulkCells(lines[s.line - 1] || '')[0];\n            return html`<li>السطر ${s.line}${ln ? html` «${ln.slice(0, 60)}»` : ''}: <strong>${s.reason}</strong></li>`;\n          })}</ul></div>` : ''}\n        </div>`);\n        m.setFoot(html`<button type=\"button\" class=\"btn btn-primary\" data-modal-close>تم</button><button type=\"button\" class=\"btn btn-secondary\" data-action=\"bulk-again\">${icon('plus')}<span>إضافة دفعة أخرى</span></button>`);\n        S.dayFetchedAt = 0;\n        return loadSchools().then(function () { if (S.view === 'schools') Schools.paintList(); }, quiet);\n      }, fail);\n    },\n    again: function () {\n      var m = A.modal.top();\n      if (!m) return;\n      m.setBody(Bulk.formHtml(''));\n      m.setFoot(Bulk.formFoot());\n      Bulk.count();\n      var el = byId('bk-text');\n      if (el) el.focus();\n    }\n  };\n\n  /* --- send links checklist */\n  var SendLinks = {\n    open: function () {\n      var list = (S.schools || []).filter(function (s) { return s.active; }).sort(function (a, b) { return cmpName(a.name, b.name); });\n      if (!S.schools) { loadSchools().then(SendLinks.open, fail); return; }\n      if (!list.length) { A.toast('أضف مدرسة واحدة على الأقل أولًا.', 'info'); return; }\n      var sample = list[0];\n      openModal({\n        title: 'إرسال الروابط للمدارس', size: 'md', className: 'ad-send-modal',\n        body: html`<div class=\"stack\">\n          ${!baseUrl() ? html`<div class=\"alert alert--warn\">${icon('alert')}<div>الروابط غير متاحة لأن النظام لم يُنشر كتطبيق ويب بعد.</div></div>` : ''}\n          <p class=\"text-sm text-2\">أرسل لكل مدير رابط مدرسته الخاص${generalEnabled() ? ' مع «رمز المدرسة»' : ''}. تظهر علامة ✓ بجانب كل مدرسة أرسلت لها في هذه الجلسة.</p>\n          <div class=\"ad-sendprog\" id=\"sl-prog\"></div>\n          <details class=\"ad-muted-box\"><summary class=\"fw-600\">معاينة نص الرسالة</summary><div class=\"ad-msg mt-2\">${msgHtml(linkMessage(sample, true))}</div><p class=\"text-xs text-muted mt-2\">يمكنك تعديل النص من الإعدادات ← رسائل واتساب.</p></details>\n          <ul class=\"ad-sendlist\">${list.map(SendLinks.item)}</ul>\n        </div>`,\n        foot: html`<button type=\"button\" class=\"btn btn-primary\" data-modal-close>تم</button><span class=\"spacer\"></span><button type=\"button\" class=\"btn btn-ghost btn-sm\" data-action=\"goto-settings\" data-anchor=\"messages\">${icon('edit')}<span>تعديل نص الرسالة</span></button>`\n      });\n      SendLinks.prog();\n    },\n    item: function (s) {\n      var sent = !!S.sentLinks[s.id];\n      return html`<li class=\"ad-send${sent ? ' is-sent' : ''}\" data-id=\"${s.id}\">\n        <span class=\"ad-send__state\" aria-hidden=\"true\">${icon('check')}</span>\n        <div class=\"ad-send__main\"><div class=\"ad-send__name\">${s.name}</div><div class=\"ad-send__sub\">${whoLine(s) || 'لا يوجد جوال — ستختار المحادثة يدويًا'}${sent ? ' • أُرسل ✓' : ''}</div></div>\n        <div class=\"ad-send__actions\">\n          <button type=\"button\" class=\"btn btn-sm btn-whatsapp\" data-action=\"sl-wa\" data-id=\"${s.id}\" aria-label=\"${'إرسال رابط «' + s.name + '» عبر واتساب'}\"${attr(!s.link, 'disabled')}>${icon('whatsapp')}<span class=\"hide-mobile\">واتساب</span></button>\n          <button type=\"button\" class=\"btn btn-sm btn-secondary btn-icon\" data-action=\"sl-copy\" data-id=\"${s.id}\" aria-label=\"${'نسخ رسالة «' + s.name + '»'}\" title=\"نسخ الرسالة\"${attr(!s.link, 'disabled')}>${icon('copy')}</button>\n        </div>\n      </li>`;\n    },\n    mark: function (id) {\n      S.sentLinks[id] = true;\n      var li = $('.ad-send[data-id=\"' + cssEsc(id) + '\"]'), s = schoolById(id);\n      if (li && s) { var tmp = document.createElement('ul'); A.render(tmp, SendLinks.item(s)); li.replaceWith(tmp.firstElementChild); }\n      SendLinks.prog();\n    },\n    prog: function () {\n      var el = byId('sl-prog');\n      if (!el) return;\n      var list = (S.schools || []).filter(function (s) { return s.active; });\n      var n = list.filter(function (s) { return S.sentLinks[s.id]; }).length;\n      var p = list.length ? Math.round(n / list.length * 100) : 0;\n      setHtml(el, html`<span>أُرسل ${n} من ${list.length}</span><div class=\"progress ${n === list.length ? 'progress--ok' : ''}\" role=\"progressbar\" aria-valuemin=\"0\" aria-valuemax=\"${list.length}\" aria-valuenow=\"${n}\" aria-label=\"تقدّم إرسال الروابط\"><div class=\"progress__bar\" style=\"width:${p}%\"></div></div>`);\n    }\n  };\n\n  /* --- QR code */\n  function openQr(title, url, sub) {\n    var m = openModal({\n      title: 'رمز QR', size: 'sm', className: 'ad-qr-modal',\n      body: html`<article class=\"doc ad-qrdoc\">\n        <div class=\"doc__brand\"><span class=\"brand\">${brandMark()}<span class=\"brand__name\">${APP_NAME}</span></span><span>${systemTitle()}</span></div>\n        <h2 class=\"doc__title mt-3\">${title}</h2>\n        ${sub ? html`<p class=\"doc__sub\">${sub}</p>` : ''}\n        <div class=\"ad-qrbox\" id=\"qr-box\"><div class=\"ad-chart-sk skeleton\" style=\"height:220px\"></div></div>\n        <p class=\"text-sm\">امسح الرمز بكاميرا الجوال لفتح نموذج المتابعة اليومية.</p>\n        <p class=\"ad-qrdoc__url\">${url}</p>\n      </article>`,\n      foot: html`<button type=\"button\" class=\"btn btn-primary\" data-action=\"doc-print\">${icon('print')}<span>طباعة</span></button><button type=\"button\" class=\"btn btn-secondary\" data-action=\"copy-url\" data-url=\"${url}\">${icon('copy')}<span>نسخ الرابط</span></button><button type=\"button\" class=\"btn btn-ghost\" data-modal-close>إغلاق</button>`\n    });\n    A.loadScript(QR_URL).then(function () {\n      var box = $('#qr-box', m.el);\n      if (!box || typeof window.qrcode !== 'function') throw new Error('qr');\n      var qr = window.qrcode(0, 'M');\n      qr.addData(url);\n      qr.make();\n      var svg = Strin