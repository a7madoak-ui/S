: var(--text-2); font-weight: 600; }\n  /* minmax(0,1fr): a wide table scrolls inside .table-wrap instead of widening (and clipping) the whole receipt */\n  .sc-receipt__body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; padding: 20px 16px 18px; }\n  .sc-sec-title { margin: 0 0 8px; font-size: 13px; font-weight: 700; color: var(--muted); }\n  .sc-kv { margin: 0; }\n  .sc-kv > div { display: flex; align-items: baseline; justify-content: space-between; gap: 6px 16px; padding: 10px 0; border-top: 1px solid var(--border); }\n  .sc-kv > div:first-child { border-top: 0; padding-top: 0; }\n  .sc-kv dt { flex: none; max-width: 55%; font-size: 14px; color: var(--text-2); }\n  .sc-kv dd { margin: 0; min-width: 0; font-size: 15px; font-weight: 600; color: var(--text); text-align: end; overflow-wrap: anywhere; }\n  .sc-kv dd.is-long { flex-basis: 100%; text-align: start; font-weight: 500; white-space: pre-line; }\n  .sc-kv > div.is-block { flex-wrap: wrap; }\n  .sc-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }\n  .sc-stat { padding: 10px 6px; border-radius: 12px; background: var(--surface-2); text-align: center; }\n  .sc-stat b { display: block; font-size: 20px; font-weight: 700; line-height: 1.3; color: var(--text); font-variant-numeric: proportional-nums; }\n  .sc-stat span { font-size: 12.5px; line-height: 1.4; color: var(--muted); }\n  .sc-stat--ok b { color: var(--ok-700); }\n  .sc-att-sum .table th, .sc-att-sum .table td { padding: 9px 10px; }\n  .sc-att-sum .table tbody th { min-width: 0; }\n  @media (max-width: 400px) {\n    .sc-att-sum .table th, .sc-att-sum .table td { padding: 8px 7px; }\n    .sc-att-sum .table thead th { white-space: normal; line-height: 1.35; }\n  }\n  .sc-receipt__foot { display: grid; gap: 10px; padding: 14px 16px 18px; border-top: 1px solid var(--border); background: #FAFBFB; }\n  .sc-receipt__foot .row { gap: 10px; }\n  .sc-receipt__foot .row > .btn { flex: 1 1 160px; }\n  .sc-receipt__note { display: flex; align-items: flex-start; justify-content: center; gap: 6px; font-size: 13.5px; color: var(--muted); text-align: center; }\n  .sc-receipt__note svg { width: 16px; height: 16px; margin-top: 3px; flex: none; }\n  .gallery > .sc-gal { padding: 0; }\n  .gallery > .sc-gal.sc-loading img { opacity: 0; }\n  .gallery > .sc-gal.sc-loading { background: linear-gradient(100deg, #ECF0F2 30%, #F6F8F9 50%, #ECF0F2 70%); background-size: 300% 100%; animation: nabd-shimmer 1.4s ease-in-out infinite; }\n  .gallery > .sc-gal.sc-broken { display: grid; place-items: center; color: var(--muted); cursor: default; }\n\n  /* Returned banners */\n  .sc-ret__note { margin-top: 4px; font-weight: 600; color: var(--danger-700); white-space: pre-line; overflow-wrap: anywhere; }\n  .sc-ret__when { margin-top: 2px; font-size: 13px; color: var(--text-2); }\n  .sc-corr-note { margin-top: 4px; padding: 10px 12px; border-radius: 10px; background: rgba(255, 255, 255, .7); font-weight: 600; white-space: pre-line; overflow-wrap: anywhere; }\n\n  /* Picker */\n  .sc-search { position: relative; }\n  .sc-search svg { position: absolute; top: 50%; inset-inline-start: 14px; width: 20px; height: 20px; margin-top: -10px; color: var(--muted); pointer-events: none; }\n  .sc-search .input { padding-inline-start: 44px; }\n  .sc-search .input::-webkit-search-cancel-button { cursor: pointer; }\n  .sc-picklist { max-height: min(50vh, 420px); overflow-y: auto; overscroll-behavior: contain; border: 1.5px solid var(--border-strong); border-radius: 14px; background: var(--surface); }\n  .sc-pick { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 54px; padding: 10px 14px; border: 0; background: transparent; color: var(--text); font: inherit; font-size: 15.5px; font-weight: 600; line-height: 1.5; text-align: start; cursor: pointer; transition: background-color var(--dur) ease; }\n  .sc-pick + .sc-pick { border-top: 1px solid var(--border); }\n  .sc-pick:hover { background: #F7FA