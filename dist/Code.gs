  "School": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#0A6453\">\n  <meta name=\"format-detection\" content=\"telephone=no\">\n  <meta name=\"robots\" content=\"noindex, nofollow\">\n  <title>نبض المدارس</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n  <?!= include('Styles') ?>\n  <style>\n  /* =========================================================================\n     School page (principal's daily form) — page-specific styles, prefix sc-\n     ======================================================================= */\n  .sc-hero { padding-bottom: 70px; }\n  .sc-hero__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }\n  .sc-hero__top .brand { font-size: 14px; font-weight: 600; }\n  .sc-hero__top .brand__mark { width: 28px; height: 28px; border-radius: 8px; }\n  .sc-hero__top .brand__mark svg { width: 17px; height: 17px; }\n  .sc-hero__school { display: flex; align-items: flex-start; gap: 8px; margin-top: 6px; font-size: 18px; font-weight: 700; line-height: 1.5; color: #FFFFFF; overflow-wrap: anywhere; }\n  .sc-hero__school svg { width: 22px; height: 22px; margin-top: 3px; opacity: .9; }\n  .sc-hero .hero__meta button { font: inherit; cursor: pointer; transition: background-color var(--dur) ease; }\n  .sc-hero .hero__meta button:hover { background: rgba(255, 255, 255, .22); }\n  .sc-hero .hero__meta svg { width: 16px; height: 16px; opacity: .9; }\n  .sc-hero .hero__meta > span { min-width: 0; overflow-wrap: anywhere; }\n\n  .sc-main { display: flex; flex-direction: column; gap: 14px; padding-bot