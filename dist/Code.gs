n  .sc-bar__progress > span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--primary-600), #19A383); border-start-end-radius: 3px; border-end-end-radius: 3px; transition: width .35s var(--ease); }\n  .sc-bar__inner { max-width: 648px; margin-inline: auto; display: grid; gap: 7px; }\n  .sc-bar__note { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 0; font-size: 13px; line-height: 1.5; color: var(--muted); text-align: center; }\n  .sc-bar__note b { color: var(--accent-700); font-weight: 700; }\n  .sc-bar__note.is-busy { color: var(--primary-700); font-weight: 600; }\n  .sc-bar__note .spinner { width: 14px; height: 14px; border-width: 2px; }\n  body.sc-has-bar { padding-bottom: calc(118px + env(safe-area-inset-bottom)); }\n  body.sc-typing .sc-bar { transform: translateY(calc(100% + 8px)); }\n\n  /* Misc */\n  .sc-footer { padding: 6px 16px 26px; text-align: center; font-size: 12.5px; color: var(--muted); }\n  .sc-footer .brand__mark { width: 18px; height: 18px; border-radius: 5px; vertical-align: -4px; margin-inline-end: 6px; }\n  .sc-footer .brand__mark::after { display: none; }\n  .sc-footer .brand__mark svg { width: 12px; height: 12px; }\n  .sc-skel-card { padding: 18px 16px; }\n  .sc-skel-card .skeleton + .skeleton { margin-top: 10px; }\n  .card .empty { padding-block: 30px; }\n  .sc-last { margin-top: 10px; }\n  .sc-empty-hint { font-size: 13.5px !important; color: var(--text-2) !important; }\n  .sc-more { align-self: flex-start; }\n  .sc-suggest { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; }\n  .sc-suggest__chip { border: 0; cursor: pointer; min-height: 34px; padding: 2px 12px; font-size: 13.5px; font-family: inherit; max-width: 100%; white-space: normal; text-align: start; }\n  .sc-suggest__chip:hover { background: var(--primary-100); }\n  @media (pointer: coarse) { .sc-suggest__chip { min-height: 40px; } }\n\n  /* Missed days (late reports) */\n  .card.sc-bf { padding: 0; overflow: hidden; }\n  .sc-bf__toggle { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 54px; padding: 10px 16px; border: 0; background: transparent; color: var(--text); font: inherit; font-size: 15px; font-weight: 700; text-align: start; cursor: pointer; }\n  .sc-bf__toggle:hover { background: #F7FAFA; }\n  .sc-bf__toggle:focus-visible { outline-offset: -3px; }\n  .sc-bf__toggle > svg { width: 20px; height: 20px; flex: none; color: var(--warn-700); }\n  .sc-bf__toggle > svg:last-child { color: var(--muted); transition: transform .2s var(--ease); }\n  .sc-bf.is-open .sc-bf__toggle > svg:last-child { transform: rotate(180deg); }\n  .sc-bf__q { flex: 1 1 auto; min-width: 0; }\n  .sc-bf__body { padding: 0 16px 14px; display: grid; gap: 10px; }\n  .sc-bf__body[hidden] { display: none; }\n  .sc-bf__hint { margin: 0; font-size: 13.5px; line-height: 1.6; color: var(--text-2); }\n  .sc-bf__days { display: grid; gap: 8px; }\n  .sc-bf__day { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: \"name icon\" \"greg icon\"; align-items: center; column-gap: 10px; width: 100%; min-height: 56px; padding: 9px 14px; border: 1.5px solid var(--border-strong); border-radius: 14px; background: var(--surface); color: var(--text); font: inherit; text-align: start; cursor: pointer; transition: border-color var(--dur) ease, background-color var(--dur) ease; }\n  .sc-bf__day:hover { border-color: var(--primary); background: var(--primary-50); }\n  .sc-bf__name { grid-area: name; font-size: 15px; font-weight: 700; line-height: 1.45; }\n  .sc-bf__greg { grid-area: greg; font-size: 13px; color: var(--muted); line-height: 1.45; }\n  .sc-bf__day > svg { grid-area: icon; width: 20px; height: 20px; color: var(--primary); }\n  .sc-shake { animation: sc-shake .36s ease; }\n  @keyframes sc-shake { 0%, 100% { transform: none; } 20% { transform: translateX(-6px); } 40% { transform: translateX(6px); } 60% { transform: translateX(-4px); } 80% { transform: translateX(3px); } }\n  .sc-flash { animation: sc-flash 1.2s ease; }\n  @keyframes sc-flash { 0% { box-shadow: 0 0 0 0 rgba(192, 57, 43, .0); } 25% { box-shadow: 0 0 0 4px rgba(192, 57, 43, .25); } 100% { box-shadow: var(--shadow-sm); } }\n  .stepper__btn { -webkit-touch-callout: none; user-select: none; -webkit-user-select: none; }\n  @media (min-width: 768px) {\n    .card.sc-q { padding: 22px 22px; }\n    .sc-receipt__body { padding: 22px 24px 20px; }\n    .sc-receipt__foot { padding: 16px 24px 20px; }\n  }\n  @media (prefers-reduced-motion: reduce) { .sc-check.is-new::after { display: none; } }\n  @media print { .sc-bar, .sc-footer { display: none !important; } body.sc-has-bar { padding-bottom: 0; } }\n  </style>\n</head>\n<body>\n  <div id=\"app\" aria-live=\"off\">\n    <noscript>\n      <div style=\"max-width:520px;margin:40px auto;padding:24px;font-family:Tahoma,sans-serif;text-align:center\">\n        هذه الصفحة تحتاج إلى تفعيل JavaScript في المتصفح.\n      </div>\n    </noscript>\n  </div>\n  <div class=\"sr-only\" id=\"sc-live\" aria-live=\"polite\" aria-atomic=\"true\"></div>\n  <script>window.BOOT = <?!= bootJson ?>;</script>\n  <?!= include('Common') ?>\n  <script>\n  /* ===========================================================================\n     نبض المدارس — principal's page (spec §7.3)\n     Picker mode (?f=all) and form mode (?s=<token>). All dynamic text goes\n     through App.html (escaped) or textContent; events use delegation with\n     data-action attributes.\n     ========================================================================= */\n  (function () {\n    'use strict';\n    var App = window.App;\n    var doc = document;\n    var root = doc.getElementById('app');\n    if (!App || !root) return;\n    var html = App.html;\n    var icon = App.icon;\n    var BOOT = window.BOOT && typeof window.BOOT === 'object' ? window.BOOT : {};\n\n    /* ------------------------------------------------------------ constants */\n    var APP_NAME = BOOT.appName || 'نبض المدارس';\n    var ATT_ROWS = ['students', 'teachers', 'staff'];\n    var ATT_LABEL = { students: 'الطلاب', teachers: 'المعلمون', staff: 'الإداريون' };\n    var MAX_TEXT = 300;\n    var MAX_AREA = 1000;\n    var MAX_COUNT = 100000;\n    var FILLED = '__filledBy';\n    var UPLOAD_CONCURRENCY = 2;\n    var KNOWN_TYPES = { number: 1, text: 1, textarea: 1, select: 1, yesno: 1, attendance: 1, photos: 1 };\n    var TYPE_ICON = { number: 'chart', text: 'edit', textarea: 'form', select: 'list', yesno: 'check-double', attendance: 'users', photos: 'camera' };\n    var ERROR_TITLES = {\n      BAD_LINK: 'الرابط غير صالح',\n      INACTIVE: 'لا يمكن الإرسال حاليًا',\n      NOT_SETUP: 'النظام غير جاهز بعد',\n      NOT_EDITABLE: 'لا يمكن فتح هذا التقرير',\n      DISABLED: 'هذا الرابط متوقف',\n      ERROR: 'تعذّر فتح الصفحة'\n    };\n    var ERROR_ICONS = { BAD_LINK: 'link', INACTIVE: 'lock', NOT_SETUP: 'settings', NOT_EDITABLE: 'lock', DISABLED: 'link', ERROR: 'alert' };\n    var COARSE = false;\n    try { COARSE = window.matchMedia('(pointer: coarse)').matches; } catch (e) { COARSE = false; }\n\n    /* ---------------------------------------------------------------- state */\n    var S = {\n      mode: BOOT.mode === 'picker' ? 'picker' : 'form',\n      token: '',\n      form: null,\n      view: 'loading',\n      viewError: null,         // {code, error} for the full-page error view\n      picker: BOOT.picker || null,\n      pickId: '',\n      pickQuery: '',\n      pickNotice: '',\n      pickChange: false,\n      answers: {},\n      att: {},                 // attendance working copy {row:{present,absent}}\n      auto: {},                // row → present was auto-filled\n      photos: {},              // fieldId → [item]\n      filledBy: '',\n      errors: {},\n      showErrors: false,\n      dirty: false,\n      editing: false,\n      correcting: false,\n      correctionNote: '',\n      offdayOverride: false,\n      submitting: false,\n      serverError: '',\n      serverErrorRetry: false,\n      draftRestored: false,\n      justSent: false,\n      showAllReturned: false,\n      backfillOpen: false,\n      clock: { server: 0, client: Date.now() }\n    };\n    var photoUrlCache = {};    // drive file id → displayable url (blob:/data:)\n    var activeUploads = 0;\n\n    /* ---------------------------------------------------------------- utils */\n    function $(sel, el) { return (el || doc).querySelector(sel); }\n    function $$(sel, el) { return Array.prototype.slice.call((el || doc).querySelectorAll(sel)); }\n    function clone(v) { return v === undefined ? undefined : JSON.parse(JSON.stringify(v)); }\n    function isNum(v) { return typeof v === 'number' && isFinite(v); }\n    function str(v) { return v === null || v === undefined ? '' : String(v); }\n    function digitsOnly(v) { return App.latinDigits(str(v)).replace(/[^0-9]/g, ''); }\n    function toCount(v) {\n      if (isNum(v)) return Math.round(v);\n      var d = digitsOnly(v);\n      return d === '' ? null : parseInt(d.slice(0, 7), 10);\n    }\n    function refCount(row) {\n      var s = S.form && S.form.school;\n      var n = s ? Number(s[row]) : 0;\n      return isFinite(n) && n > 0 ? Math.round(n) : 0;\n    }\n    function hhmmToMin(t) {\n      var m = /^(\\d{1,2}):(\\d{2})/.exec(str(t));\n      return m ? (+m[1]) * 60 + (+m[2]) : null;\n    }\n    function nowMin() { return S.clock.server + Math.floor((Date.now() - S.clock.client) / 60000); }\n    function announce(msg) {\n      var live = doc.getElementById('sc-live');\n      if (!live) return;\n      live.textContent = '';\n      setTimeout(function () { live.textContent = msg; }, 30);\n    }\n    /** Arabic counted noun: 1 → one, 2 → two, 3–10 → n few, otherwise n many. */\n    function arCount(n, one, two, few, many) {\n      if (n === 1) return one;\n      if (n === 2) return two;\n      if (n >= 3 && n <= 10) return n + ' ' + few;\n      return App.fmt.num(n) + ' ' + many;\n    }\n    function photosWord(n) { return arCount(n, 'صورة واحدة', 'صورتان', 'صور', 'صورة'); }\n    /* oblique case (after a preposition or verbal noun): «حتى صورتين», «رفع صورتين» */\n    function photosWordG(n) { return arCount(n, 'صورة واحدة', 'صورتين', 'صور', 'صورة'); }\n    function minutesWord(n) { return arCount(n, 'دقيقة واحدة', 'دقيقتين', 'دقائق', 'دقيقة'); }\n    function editsWord(n) { return arCount(n, 'مرة واحدة', 'مرتين', 'مرات', 'مرة'); }\n    function normSearch(s) {\n      return App.latinDigits(str(s)).toLowerCase()\n        .replace(/[\\u064B-\\u0652\\u0640]/g, '')\n        .replace(/[أإآٱ]/g, 'ا').replace(/ة/g, 'ه').replace(/ى/g, 'ي').replace(/ؤ/g, 'و').replace(/ئ/g, 'ي')\n        .replace(/\\s+/g, ' ').trim();\n    }\n    function dayLabel(iso) { return App.date.dayName(iso) + ' ' + App.date.hijri(iso, { withYear: false }); }\n    function tsLabel(ts, refDate) {\n      var t = App.time.fmt(ts);\n      if (!t) return '';\n      var d = str(ts).slice(0, 10);\n      if (refDate && App.date.isISO(d) && d !== refDate) return App.date.greg(d, { withYear: false }) + '، ' + t;\n      return t;\n    }\n    function storeKeyDraft() { return 'draft:' + S.token + ':' + (S.form ? S.form.date : ''); }\n    function isPreview() { return !!(S.form && S.form.preview); }\n    function fields() {\n      var f = S.form && Array.isArray(S.form.fields) ? S.form.fields : [];\n      return f.filter(function (x) { return x && typeof x.id === 'string' && KNOWN_TYPES[x.type]; });\n    }\n    function fieldById(id) {\n      var list = fields();\n      for (var i = 0; i < list.length; i++) if (list[i].id === id) return list[i];\n      return null;\n    }\n    function kpiField(k) {\n      var list = fields();\n      for (var i = 0; i < list.length; i++) if (list[i].kpi === k) return list[i];\n      return null;\n    }\n    function attField() {\n      var list = fields();\n      for (var i = 0; i < list.length; i++) if (list[i].type === 'attendance') return list[i];\n      return null;\n    }\n    function attRows(f) {\n      var rows = f && Array.isArray(f.rows) ? f.rows.filter(function (r) { return ATT_LABEL[r]; }) : [];\n      return rows.length ? rows : ATT_ROWS.slice();\n    }\n    function lessonsPair() {\n      var p = kpiField('lessons_planned'), d = kpiField('lessons_done');\n      return p && d && p.type === 'number' && d.type === 'number' ? { p: p, d: d } : null;\n    }\n    function maxPhotos(f) {\n      var n = Number(f && f.maxCount);\n      return isFinite(n) && n >= 1 ? Math.min(10, Math.round(n)) : 6;\n    }\n    function numBounds(f) {\n      var min = isNum(f.min) ? f.min : 0;\n      var max = isNum(f.max) ? f.max : MAX_COUNT;\n      return { min: Math.max(0, min), max: Math.min(MAX_COUNT, max) };\n    }\n    function scrollToEl(el, block) {\n      if (!el) return;\n      try { el.scrollIntoView({ behavior: 'smooth', block: block || 'center' }); } catch (e) { el.scrollIntoView(); }\n    }\n    function focusNoScroll(el) {\n      if (!el) return;\n      try { el.focus({ preventScroll: true }); } catch (e) { el.focus(); }\n    }\n\n    /* =============================================================== VIEWS */\n    function heroHtml() {\n      var f = S.form;\n      var title = (f && f.systemTitle) || BOOT.systemTitle || 'متابعة سير العملية التعليمية';\n      var sup = (f && f.ok && f.supervisor) || (S.picker && S.picker.ok && S.picker.supervisor) || null;\n      var toLine = sup && (sup.title || sup.name) ? ('إلى: ' + [sup.title, sup.name].filter(Boolean).join(' ')) : '';\n      var showSchool = S.view !== 'picker' && S.view !== 'error' && f && f.ok && f.school;\n      var canChange = S.mode === 'picker' && S.view !== 'picker' && S.view !== 'error' && S.token && !isPreview();\n      return html`<header class=\"hero sc-hero\">\n        <div class=\"sc-hero__top\">\n          <span class=\"brand\"><span class=\"brand__mark\">${icon('pulse')}</span><span class=\"brand__name\">${APP_NAME}</span></span>\n        </div>\n        <h1 class=\"hero__title\">${title}</h1>\n        ${showSchool\n          ? html`<p class=\"sc-hero__school\">${icon('school')}<span>${f.school.name}</span></p>`\n          : html`<p class=\"hero__sub\">صفحة إدخال البيانات اليومية وإرسالها للمشرف</p>`}\n        ${toLine || canChange ? html`<div class=\"hero__meta\">\n          ${toLine ? html`<span>${icon('user')}<span>${toLine}</span></span>` : ''}\n          ${canChange ? html`<button type=\"button\" data-action=\"change-school\">${icon('refresh')}<span>تغيير المدرسة</span></button>` : ''}\n        </div>` : ''}\n      </header>`;\n    }\n\n    function footerHtml() {\n      return html`<footer class=\"sc-footer\"><span class=\"brand__mark\" aria-hidden=\"true\">${icon('pulse')}</span>${APP_NAME} • بياناتك تُرسل مباشرة إلى المشرف</footer>`;\n    }\n\n    function skeletonHtml() {\n      return html`<section class=\"card sc-skel-card\" aria-busy=\"true\" aria-label=\"جارٍ التحميل\">\n          <span class=\"skeleton skeleton--title\"></span><span class=\"skeleton skeleton--text\"></span>\n        </section>\n        <section class=\"card sc-skel-card\"><span class=\"skeleton skeleton--title\"></span><span class=\"skeleton skeleton--block\"></span></section>\n        <section class=\"card sc-skel-card\"><span class=\"skeleton skeleton--title\"></span><span class=\"skeleton skeleton--block\"></span></section>`;\n    }\n\n    function errorHtml(err) {\n      var code = err && ERROR_TITLES[err.code] ? err.code : 'ERROR';\n      var msg = (err && err.error) || 'حدث خطأ غير متوقع. حاول مرة أخرى بعد قليل.';\n      var network = err && err.network;\n      var tone = code === 'BAD_LINK' || code === 'ERROR' ? 'empty--danger' : 'empty--warn';\n      return html`<section class=\"card\" role=\"alert\">\n        <div class=\"empty ${tone}\">\n          ${icon(network ? 'wifi-off' : ERROR_ICONS[code])}\n          <h2>${network ? 'تعذّر الاتصال' : ERROR_TITLES[code]}</h2>\n          <p>${msg}</p>\n          ${code === 'BAD_LINK' ? html`<p class=\"sc-empty-hint\">تأكد أنك فتحت آخر رابط أرسله لك المشرف</p>` : ''}\n          ${code === 'INACTIVE' ? html`<p class=\"sc-empty-hint\">للاستفسار تواصل مع المشرف.</p>` : ''}\n          ${code === 'DISABLED' ? html`<p class=\"sc-empty-hint\">تجد رابط مدرستك الخاص في رسالة المشرف إليك.</p>` : ''}\n          ${code === 'ERROR' && S.token ? html`<button type=\"button\" class=\"btn btn-secondary\" data-action=\"retry-load\">${icon('refresh')}<span>إعادة المحاولة</span></button>` : ''}\n          ${code === 'ERROR' && !S.token ? html`<p class=\"sc-empty-hint\">حدّث الصفحة بعد قليل، وإذا تكرر الأمر تواصل مع المشرف.</p>` : ''}\n        </div>\n      </section>`;\n    }\n\n    /* ---------------------------------------------------------- picker view */\n    function pickerHtml() {\n      var p = S.picker;\n      if (!p || !p.ok) return errorHtml(p || { code: 'ERROR' });\n      var stored = App.store.get('school', null);\n      if (stored && stored.token && !S.pickChange) {\n        return html`<section class=\"card\"><div class=\"card__body stack\">\n          <div class=\"sc-cont\">\n            <span class=\"sc-cont-icon\" aria-hidden=\"true\">${icon('school')}</span>\n            <div><p class=\"sc-cont__label\">متابعة باسم:</p><p class=\"sc-cont__name\">${stored.schoolName || 'مدرستك'}</p></div>\n          </div>\n          <div class=\"sc-actions\">\n            <button type=\"button\" class=\"btn btn-primary btn-lg btn-block\" data-action=\"continue\">${icon('chevron-left')}<span>متابعة</span></button>\n            <button type=\"button\" class=\"btn btn-secondary btn-block\" data-action=\"pick-other\">${icon('refresh')}<span>تغيير المدرسة</span></button>\n          </div>\n        </div></section>`;\n      }\n      var schools = Array.isArray(p.schools) ? p.schools : [];\n      var sel = schools.filter(function (s) { return s.id === S.pickId; })[0] || null;\n      var notice = S.pickNotice ? html`<div class=\"alert alert--warn\">${icon('info')}<div>${S.pickNotice}</div></div>` : '';\n      if (!schools.length) {\n        return html`${notice}<section class=\"card\"><div class=\"empty\">${icon('school')}<h2>لا توجد مدارس بعد</h2><p>لم يُضف المشرف أي مدرسة حتى الآن. تواصل مع المشرف.</p></div></section>`;\n      }\n      var listPart;\n      if (sel) {\n        listPart = html`<div class=\"sc-selected\">\n          ${icon('check')}\n          <span class=\"sc-selected__name\">${sel.name}</span>\n          <button type=\"button\" class=\"btn btn-ghost btn-sm\" data-action=\"pick-clear\">تغيير</button>\n        </div>`;\n      } else {\n        listPart = html`${schools.length > 6 ? html`<div class=\"sc-search\">${icon('search')}\n            <input class=\"input\" type=\"search\" id=\"sc-search\" data-kind=\"search\" placeholder=\"ابحث عن اسم مدرستك…\" aria-label=\"ابحث عن مدرستك\" autocomplete=\"off\" enterkeyhint=\"search\" value=\"${S.pickQuery}\">\n          </div>` : ''}\n          <div class=\"sc-picklist\" id=\"sc-picklist\" role=\"group\" aria-label=\"قائمة المدارس\">${pickListItems(schools)}</div>`;\n      }\n      return html`${notice}<section class=\"card\">\n        <div class=\"card__head\">${icon('school')}<h2 class=\"card__title\">اختر مدرستك</h2></div>\n        <div class=\"card__body stack\">\n          ${listPart}\n          <div class=\"field\" id=\"pin-field\">\n            <label class=\"field__label\" for=\"sc-pin\">رمز المدرسة</label>\n            <input class=\"input sc-pin\" id=\"sc-pin\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]*\" maxlength=\"4\" autocomplete=\"off\" enterkeyhint=\"go\" data-kind=\"pin\" placeholder=\"••••\" aria-describedby=\"pin-hint pin-err\">\n            <p class=\"field__hint\" id=\"pin-hint\">رمز المدرسة يرسله لك المشرف مرة واحدة</p>\n            <p class=\"field__error\" id=\"pin-err\" aria-live=\"polite\">${icon('alert')}<span></span></p>\n          </div>\n          <button type=\"button\" class=\"btn btn-primary btn-lg btn-block\" id=\"sc-enter\" data-action=\"enter\">${icon('lock')}<span>دخول</span></button>\n          ${stored && stored.token && S.pickChange ? html`<button type=\"button\" class=\"btn btn-ghost btn-block\" data-action=\"pick-back\">${icon('chevron-right')}<span>العودة إلى ${stored.schoolName || 'مدرستي السابقة'}</span></button>` : ''}\n        </div>\n      </section>`;\n    }\n    function pickListItems(schools) {\n      var q = normSearch(S.pickQuery);\n      var list = schools.filter(function (s) { return !q || normSearch(s.name).indexOf(q) >= 0; });\n      if (!list.length) return html`<div class=\"sc-pick-empty\">لا توجد مدرسة بهذا الاسم. جرّب كلمة أخرى.</div>`;\n      return list.map(function (s) {\n        return html`<button type=\"button\" class=\"sc-pick\" data-action=\"pick\" data-id=\"${s.id}\">${icon('school')}<span>${s.name}</span></button>`;\n      });\n    }\n\n    /* ------------------------------------------------------- date strip */\n    /** Today's deadline has passed on this page's (server-synced) clock. */\n    function deadlinePassedNow() {\n      var dlMin = hhmmToMin(S.form && S.form.deadline);\n      return dlMin !== null && nowMin() > dlMin;\n    }\n    function isOffday() { return !!(S.form && (!S.form.isWorkday || S.form.isHoliday)); }\n    /** Late submissions are off and the deadline passed while this (new, not yet sent) form was open. */\n    function closedNow() {\n      var f = S.form;\n      return !!(f && !isPreview() && f.allowLate === false && f.state === 'open' && !f.existing && !isOffday() && deadlinePassedNow());\n    }\n    function deadlineChipHtml() {\n      var f = S.form;\n      var dl = App.time.fmt(f.deadline);\n      if (S.correcting && f.state === 'correction') return html`<span class=\"chip chip--warn\">${icon('undo')}<span>تصحيح تقرير سابق</span></span>`;\n      if (f.state === 'backfill' && !f.existing) return html`<span class=\"chip chip--warn\">${icon('calendar')}<span>تقرير يوم فائت — يُسجَّل متأخرًا</span></span>`;\n      if (f.existing && !S.editing && !isPreview()) return App.status.badge(f.existing.status);\n      if (S.editing && f.existing) {\n        if (f.existing.status === 'returned') return html`<span class=\"chip chip--warn\">${icon('undo')}<span>تصحيح التقرير</span></span>`;\n        return html`<span class=\"chip chip--info\">${icon('edit')}<span>تعديل تقرير مُرسل</span></span>`;\n      }\n      if (isOffday() && !isPreview() && !S.offdayOverride) {\n        return html`<span class=\"chip\">${icon('calendar')}<span>${f.isHoliday ? 'يوم إجازة' : 'ليس يوم دوام'}</span></span>`;\n      }\n      if (f.state === 'closed') return html`<span class=\"chip chip--danger\">${icon('lock')}<span>انتهى وقت الإرسال</span></span>`;\n      // No deadline on an off day (holiday / weekend): a report sent anyway is never late.\n      if (isOffday()) return html`<span class=\"chip\" id=\"sc-dl\">${icon('calendar')}<span>${f.isHoliday ? 'يوم إجازة' : 'ليس يوم دوام'} — لا يوجد موعد نهائي</span></span>`;\n      var dlMin = hhmmToMin(f.deadline);\n      var past = f.state === 'late' || deadlinePassedNow();\n      if (past && f.allowLate === false && f.state !== 'late') return html`<span class=\"chip chip--danger\" id=\"sc-dl\">${icon('lock')}<span>انتهى وقت الإرسال</span></span>`;\n      if (past) return html`<span class=\"chip chip--warn\" id=\"sc-dl\">${icon('alert')}<span>تجاوزت الموعد — سيُسجَّل التقرير متأخرًا</span></span>`;\n      var left = dlMin !== null ? dlMin - nowMin() : null;\n      var soon = left !== null && left >= 0 && left <= 60 ? ' • بعد ' + (left < 1 ? 'أقل من دقيقة' : minutesWord(left)) : '';\n      return html`<span class=\"chip chip--info\" id=\"sc-dl\">${icon('clock')}<span>آخر موعد للإرسال ${dl}${soon}</span></span>`;\n    }\n    function dateCardHtml() {\n      var d = S.form.date;\n      return html`<section class=\"card sc-date\" aria-label=\"تاريخ التقرير\">\n        <span class=\"sc-date__icon\" aria-hidden=\"true\">${icon('calendar')}</span>\n        <div>\n          <div class=\"sc-date__day\">${App.date.dayName(d)} <span class=\"fw-500\">${App.date.hijri(d)}</span></div>\n          <div class=\"sc-date__sub\">${App.date.greg(d)}${S.form.state === 'correction' ? ' • تقرير يوم سابق' : (S.form.state === 'backfill' ? ' • تقرير يوم فائت' : '')}</div>\n        </div>\n        <div class=\"sc-date__chip\" id=\"sc-chip\">${deadlineChipHtml()}</div>\n      </section>`;\n    }\n\n    /* ----------------------------------------------------- returned banners */\n    function returnedBannersHtml() {\n      var f = S.form;\n      if (!f || !Array.isArray(f.returned) || !f.returned.length || S.correcting || isPreview()) return '';\n      var list = f.returned.filter(function (r) { return r && App.date.isISO(r.date); });\n      var shown = S.showAllReturned ? list : list.slice(0, 2);\n      var items = shown.map(function (r) {\n        return html`<div class=\"alert alert--danger\" data-returned=\"${r.date}\">\n          ${icon('undo')}\n          <div>\n            <strong class=\"alert__title\">أعاد المشرف تقرير يوم ${dayLabel(r.date)} للتصحيح:</strong>\n            <p class=\"sc-ret__when\">${App.date.greg(r.date)}${r.date === f.today ? ' (اليوم)' : ''}</p>\n            <p class=\"sc-ret__note\">«${r.reviewNote || 'يرجى مراجعة التقرير وتصحيحه'}»</p>\n            <div class=\"alert__actions\">\n              <button type=\"button\" class=\"btn btn-danger btn-sm\" data-action=\"correct\" data-date=\"${r.date}\">${icon('edit')}<span>تصحيح التقرير</span></button>\n            </div>\n          </div>\n        </div>`;\n      });\n      var more = list.length > shown.length\n        ? html`<button type=\"button\" class=\"btn btn-ghost btn-sm sc-more\" data-action=\"more-returned\">${icon('chevron-down')}<span>عرض باقي التقارير المعادة (${list.length - shown.length})</span></button>`\n        : '';\n      return html`${items}${more}`;\n    }\n\n    /** «لم ترسل تقرير يوم سابق؟» — missed workdays the school may still report (late), newest first. */\n    function backfillHtml() {\n      var f = S.form;\n      if (!f || !f.ok || isPreview() || S.correcting || S.editing || f.state === 'backfill' || f.state === 'correction') return '';\n      var days = (Array.isArray(f.missingDays) ? f.missingDays : []).filter(function (d) { return App.date.isISO(d); });\n      if (!days.length) return '';\n      var open = S.backfillOpen;\n      return html`<section class=\"card sc-bf${open ? ' is-open' : ''}\" id=\"sc-bf\">\n        <button type=\"button\" class=\"sc-bf__toggle\" data-action=\"bf-toggle\" aria-expanded=\"${open ? 'true' : 'false'}\" aria-controls=\"sc-bf-list\">\n          ${icon('calendar')}<span class=\"sc-bf__q\">لم ترسل تقرير يوم سابق؟</span><span class=\"badge badge--warn\">${days.length}</span>${icon('chevron-down')}\n        </button>\n        <div class=\"sc-bf__body\" id=\"sc-bf-list\"${open ? '' : App.raw(' hidden')}>\n          <p class=\"sc-bf__hint\">يمكنك إرسال تقرير ${days.length === 1 ? 'هذا اليوم' : 'أحد هذه الأيام'} الآن، ويُسجَّل «متأخرًا».</p>\n          <div class=\"sc-bf__days\">${days.map(function (d) {\n            return html`<button type=\"button\" class=\"sc-bf__day\" data-action=\"backfill\" data-date=\"${d}\" aria-label=\"${'إرسال تقرير يوم ' + App.date.dayName(d) + ' ' + App.date.greg(d)}\">\n              <span class=\"sc-bf__name\">${App.date.dayName(d)} <span class=\"fw-500\">${App.date.hijri(d, { withYear: false })}</span></span>\n              <span class=\"sc-bf__greg\">${App.date.greg(d)}</span>${icon('chevron-left')}</button>`;\n          })}</div>\n        </div>\n      </section>`;\n    }\n\n    function topAlertsHtml() {\n      var out = [];\n      if (isPreview()) {\n        out.push(html`<div class=\"alert alert--info\">${icon('eye')}<div><strong class=\"alert__title\">وضع المعاينة — لن يتم إرسال أي بيانات</strong>\n          <span class=\"text-sm\">هكذا تظهر الصفحة لمدير المدرسة. يمكنك تجربة التعبئة، أما الإرسال ورفع الصور فمعطّلان.</span></div></div>`);\n      }\n      if (S.serverError) out.push(serverErrorHtml());\n      return out;\n    }\n    function serverErrorHtml() {\n      return html`<div class=\"alert alert--danger\" id=\"sc-server-error\" role=\"alert\">${icon('alert')}<div>\n        <strong class=\"alert__title\">لم يُرسل التقرير</strong><span>${S.serverError}</span>\n        ${S.serverErrorRetry ? html`<p class=\"text-sm text-2 mt-1\">ما كتبته محفوظ على هذا الجهاز ولن يضيع.</p>` : ''}\n        <div class=\"alert__actions\">\n          ${S.serverErrorRetry ? html`<button type=\"button\" class=\"btn btn-danger btn-sm\" data-action=\"submit\">${icon('refresh')}<span>إعادة المحاولة</span></button>` : ''}\n          <button type=\"button\" class=\"btn btn-ghost btn-sm\" data-action=\"dismiss-error\">إخفاء</button>\n        </div>\n      </div></div>`;\n    }\n\n    /* ============================================================ FORM VIEW */\n    function optTag(f) { return f.required ? '' : html`<span class=\"sc-opt\">اختياري</span>`; }\n    function errEl(id) { return html`<p class=\"field__error\" id=\"er-${id}\" aria-live=\"polite\">${icon('alert')}<span></span></p>`; }\n    function qHead(o) {\n      var label = o.labelFor\n        ? html`<label class=\"field__label sc-qtitle\" id=\"lb-${o.id}\" for=\"${o.labelFor}\">${o.title}${o.opt || ''}</label>`\n        : html`<span class=\"field__label sc-qtitle\" id=\"lb-${o.id}\">${o.title}${o.opt || ''}</span>`;\n      return html`<div class=\"sc-qhead\">\n        <span class=\"sc-qicon\" aria-hidden=\"true\">${icon(o.icon)}<span class=\"sc-qicon__ok\">${icon('check')}</span></span>\n        <div class=\"sc-qtext\">${label}${o.help ? html`<p class=\"field__hint\" id=\"hp-${o.id}\">${o.help}</p>` : ''}</div>\n      </div>`;\n    }\n    function describedBy(f) { return 'er-' + f.id + (f.help ? ' hp-' + f.id : ''); }\n\n    function stepperHtml(f, ariaLabelledby) {\n      var v = S.answers[f.id];\n      return html`<div class=\"stepper\">\n        <button type=\"button\" class=\"stepper__btn\" tabindex=\"-1\" data-action=\"step\" data-step=\"-1\" data-fid=\"${f.id}\" aria-label=\"إنقاص ${f.label}\">${icon('minus')}</button>\n        <input class=\"stepper__input\" id=\"in-${f.id}\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]*\" maxlength=\"6\" autocomplete=\"off\" enterkeyhint=\"next\"\n          data-kind=\"num\" data-fid=\"${f.id}\" data-nav value=\"${isNum(v) ? String(v) : ''}\"\n          aria-labelledby=\"${ariaLabelledby}\" aria-describedby=\"${describedBy(f)}\">\n        <button type=\"button\" class=\"stepper__btn\" tabindex=\"-1\" data-action=\"step\" data-step=\"1\" data-fid=\"${f.id}\" aria-label=\"زيادة ${f.label}\">${icon('plus')}</button>\n      </div>`;\n    }\n\n    function choiceGroupHtml(f, options) {\n      var cur = S.answers[f.id];\n      if (options.length > 8) {\n        return html`<select class=\"select sc-select-native\" id=\"in-${f.id}\" data-kind=\"select\" data-fid=\"${f.id}\" aria-labelledby=\"lb-${f.id}\" aria-describedby=\"${describedBy(f)}\">\n          <option value=\"\">— اختر —</option>\n          ${options.map(function (o, i) { return html`<option value=\"${i}\"${o.value === cur ? App.raw(' selected') : ''}>${o.label}</option>`; })}\n        </select>`;\n      }\n      return html`<div class=\"choice-group\" role=\"radiogroup\" aria-labelledby=\"lb-${f.id}\" aria-describedby=\"${describedBy(f)}\">\n        ${options.map(function (o, i) {\n          var on = o.value === cur;\n          return html`<button type=\"button\" class=\"choice${options.length > 4 ? ' sc-choice-sm' : ''}\" role=\"radio\" aria-checked=\"${on ? 'true' : 'false'}\" data-action=\"choose\" data-fid=\"${f.id}\" data-index=\"${i}\">${o.label}</button>`;\n        })}\n      </div>`;\n    }\n    function optionsOf(f) {\n      if (f.type === 'yesno') return [{ label: 'نعم', value: true }, { label: 'لا', value: false }];\n      return (Array.isArray(f.options) ? f.options : []).map(function (o) { return { label: str(o), value: str(o) }; });\n    }\n\n    function attendanceHtml(f) {\n      var rows = attRows(f);\n      var hasRef = rows.some(function (r) { return refCount(r) > 0; });\n      return html`${hasRef ? html`<p class=\"sc-att-intro\">${icon('sparkle')}<span>اكتب عدد <b>الغائبين</b>، ويُحسب عدد الحاضرين تلقائيًا من العدد المسجّل للمدرسة. يمكنك تعديله.</span></p>` : ''}\n        <table class=\"att-table\">\n          <thead><tr><th scope=\"col\">الفئة</th><th scope=\"col\">الحاضرون</th><th scope=\"col\">الغائبون</th></tr></thead>\n          <tbody>${rows.map(function (r) {\n            var c = S.att[r] || {};\n            return html`<tr data-row=\"${r}\">\n              <th scope=\"row\"><span>${ATT_LABEL[r]}</span><span class=\"chip chip--primary sc-att-chip\" data-chip=\"${r}\" hidden></span></th>\n              <td data-label=\"الحاضرون\"><input class=\"input${S.auto[r] ? ' is-auto' : ''}\" id=\"att-${r}-present\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]*\" maxlength=\"6\" autocomplete=\"off\" enterkeyhint=\"next\"\n                data-kind=\"att\" data-row=\"${r}\" data-part=\"present\" data-nav value=\"${isNum(c.present) ? String(c.present) : ''}\" aria-label=\"${ATT_LABEL[r]} — الحاضرون\" aria-describedby=\"er-${f.id}\"><span class=\"tag\" data-tag=\"${r}\"${S.auto[r] ? '' : App.raw(' hidden')}>تلقائي</span></td>\n              <td data-label=\"الغائبون\"><input class=\"input\" id=\"att-${r}-absent\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]*\" maxlength=\"6\" autocomplete=\"off\" enterkeyhint=\"next\"\n                data-kind=\"att\" data-row=\"${r}\" data-part=\"absent\" data-nav value=\"${isNum(c.absent) ? String(c.absent) : ''}\" aria-label=\"${ATT_LABEL[r]} — الغائبون\" aria-describedby=\"er-${f.id}\"></td>\n            </tr>`;\n          })}</tbody>\n        </table>\n        <ul class=\"sc-att-hints\" id=\"att-hints\">${rows.map(function (r) {\n          return html`<li data-hint=\"${r}\" hidden>${icon('info')}<span></span></li>`;\n        })}</ul>`;\n    }\n\n    function textHtml(f) {\n      var v = str(S.answers[f.id]);\n      var area = f.type === 'textarea';\n      var max = area ? MAX_AREA : MAX_TEXT;\n      var control = area\n        ? html`<textarea class=\"textarea\" id=\"in-${f.id}\" rows=\"3\" maxlength=\"${max}\" data-kind=\"text\" data-fid=\"${f.id}\" aria-labelledby=\"lb-${f.id}\" aria-describedby=\"${describedBy(f)} ct-${f.id}\" placeholder=\"اكتب هنا…\">${v}</textarea>`\n        : html`<input class=\"input\" id=\"in-${f.id}\" type=\"text\" maxlength=\"${max}\" autocomplete=\"off\" enterkeyhint=\"next\" data-kind=\"text\" data-fid=\"${f.id}\" data-nav value=\"${v}\" aria-labelledby=\"lb-${f.id}\" aria-describedby=\"${describedBy(f)} ct-${f.id}\">`;\n      return html`${control}<div class=\"field__foot\"><span></span><span class=\"field__count\" id=\"ct-${f.id}\" hidden></span></div>`;\n    }\n\n    function fieldSectionHtml(f) {\n      var labelFor = f.type === 'number' || f.type === 'text' || f.type === 'textarea' ? 'in-' + f.id : '';\n      var ic = f.kpi === 'mode' ? 'grid' : (f.kpi === 'late_students' ? 'clock' : TYPE_ICON[f.type]);\n      var body;\n      if (f.type === 'number') body = stepperHtml(f, 'lb-' + f.id);\n      else if (f.type === 'select' || f.type === 'yesno') body = choiceGroupHtml(f, optionsOf(f));\n      else if (f.type === 'attendance') body = attendanceHtml(f);\n      else if (f.type === 'photos') body = html`<div class=\"uploader\" id=\"up-${f.id}\" data-fid=\"${f.id}\">${uploaderInner(f)}</div>`;\n      else body = textHtml(f);\n      return html`<section class=\"card sc-q\" id=\"q-${f.id}\" data-q=\"${f.id}\">\n        <div class=\"field${f.type === 'attendance' ? ' sc-att' : ''}\" data-fid=\"${f.id}\">\n          ${qHead({ id: f.id, icon: ic, title: f.label, opt: optTag(f), help: f.help, labelFor: labelFor })}\n          ${body}\n          ${errEl(f.id)}\n        </div>\n      </section>`;\n    }\n\n    function lessonsSectionHtml(pair) {\n      var both = [pair.p, pair.d];\n      var anyOpt = !pair.p.required && !pair.d.required;\n      return html`<section class=\"card sc-q\" id=\"q-lessons\" data-q=\"lessons\">\n        ${qHead({ id: 'lessons', icon: 'book', title: 'تفعيل الحصص الدراسية', opt: anyOpt ? html`<span class=\"sc-opt\">اختياري</span>` : '' })}\n        <div class=\"sc-pair\">\n          ${both.map(function (f) {\n            return html`<div class=\"field\" data-fid=\"${f.id}\">\n              <label class=\"field__label\" id=\"lb-${f.id}\" for=\"in-${f.id}\">${f.label}${pair.p.required !== pair.d.required ? optTag(f) : ''}</label>\n              ${stepperHtml(f, 'lb-' + f.id)}\n              ${errEl(f.id)}\n            </div>`;\n          })}\n        </div>\n        ${lastPlannedHtml(pair)}\n        ${both.some(function (f) { return f.help; }) ? html`<div class=\"sc-pair-hints\">${both.map(function (f) {\n          return f.help ? html`<p class=\"field__hint\" id=\"hp-${f.id}\">${f.help}</p>` : '';\n        })}</div>` : ''}\n        <div class=\"sc-calc\" id=\"sc-calc\" aria-live=\"polite\">\n          <div class=\"sc-calc__row\"><span>غير المفعّلة: <b id=\"calc-not\">—</b></span><span>نسبة التفعيل: <b id=\"calc-pct\">—</b></span></div>\n          <div class=\"progress\"><div class=\"progress__bar\" id=\"calc-bar\"></div></div>\n          <p class=\"sc-calc__msg\">عدد الحصص المفعّلة لا يمكن أن يتجاوز عدد الحصص المخطط لها</p>\n        </div>\n      </section>`;\n    }\n\n    /** «من آخر تقرير» — the planned-lessons count rarely changes, offer it as a one-tap suggestion. */\n    function lastPlannedHtml(pair) {\n      if (S.form.existing || isPreview() || isNum(S.answers[pair.p.id])) return '';\n      var last = App.store.get('last:' + S.token, null);\n      var n = last && isNum(last.planned) ? last.planned : null;\n      if (n === null) return '';\n      return html`<div class=\"sc-suggest sc-last\" id=\"sc-last\"><span class=\"text-sm text-muted\">من آخر تقرير:</span>\n        <button type=\"button\" class=\"chip chip--primary sc-suggest__chip\" data-action=\"use-last\" data-fid=\"${pair.p.id}\" data-value=\"${n}\" aria-label=\"استخدام ${pair.p.label} ${n}\">${icon('refresh')}<span>${pair.p.label}: ${App.fmt.num(n)}</span></button></div>`;\n    }\n    function filledBySectionHtml() {\n      var principal = S.form.school && S.form.school.principal ? str(S.form.school.principal).trim() : '';\n      var suggest = principal && principal !== S.filledBy.trim()\n        ? html`<div class=\"sc-suggest\"><span class=\"text-sm text-muted\">اقتراح:</span><button type=\"button\" class=\"chip chip--primary sc-suggest__chip\" data-action=\"use-principal\" aria-label=\"استخدام اسم ${principal}\">${icon('user')}<span>${principal}</span></button></div>`\n        : '';\n      return html`<section class=\"card sc-q\" id=\"q-${FILLED}\" data-q=\"${FILLED}\">\n        <div class=\"field\" data-fid=\"${FILLED}\">\n          ${qHead({ id: FILLED, icon: 'user', title: 'اسم من يعبّئ التقرير', labelFor: 'in-filledBy', help: 'يُحفظ الاسم على هذا الجهاز لتوفير الوقت في المرات القادمة.' })}\n          <input class=\"input\" id=\"in-filledBy\" type=\"text\" maxlength=\"80\" autocomplete=\"name\" enterkeyhint=\"done\" data-kind=\"filledBy\" data-nav\n            value=\"${S.filledBy}\" placeholder=\"مثال: أ. خالد العتيبي\" aria-describedby=\"er-${FILLED} hp-${FILLED}\">\n          <div id=\"sc-suggest\">${suggest}</div>\n          ${errEl(FILLED)}\n        </div>\n      </section>`;\n    }\n\n    function formNoticeHtml() {\n      var f = S.form;\n      if (S.correcting) {\n        var note = S.correctionNote || (f.existing && f.existing.reviewNote) || '';\n        return html`<div class=\"alert alert--warn\" id=\"sc-corr\">${icon('undo')}<div>\n          <strong class=\"alert__title\">تصحيح تقرير يوم ${dayLabel(f.date)}</strong>\n          <span class=\"text-sm\">ملاحظة المشرف:</span>\n          <p class=\"sc-corr-note\">«${note || 'يرجى مراجعة التقرير وتصحيحه'}»</p>\n          <p class=\"text-sm mt-2\">عدّل ما يلزم ثم اضغط «إرسال التصحيح» في الأسفل.</p>\n          <div class=\"alert__actions\"><button type=\"button\" class=\"btn btn-secondary btn-sm\" data-action=\"cancel-edit\">${icon('chevron-right')}<span>${f.state === 'correction' ? 'العودة إلى تقرير اليوم' : 'إلغاء'}</span></button></div>\n        </div></div>`;\n      }\n      if (f.state === 'backfill' && !f.existing) {\n        return html`<div class=\"alert alert--warn\" id=\"sc-bf-note\">${icon('calendar')}<div>\n          <strong class=\"alert__title\">تقرير يوم ${dayLabel(f.date)}</strong>\n          <span class=\"text-sm\">أنت ترسل تقرير يوم فائت (${App.date.greg(f.date)})، ويُسجَّل «متأخرًا». اكتب بيانات ذلك اليوم.</span>\n          ${S.draftRestored ? html`<p class=\"text-sm mt-1\">استعدنا ما كتبته سابقًا لهذا اليوم.</p>` : ''}\n          <div class=\"alert__actions\">\n            <button type=\"button\" class=\"btn btn-secondary btn-sm\" data-action=\"cancel-edit\">${icon('chevron-right')}<span>العودة إلى تقرير اليوم</span></button>\n            ${S.draftRestored ? html`<button type=\"button\" class=\"btn btn-ghost btn-sm\" data-action=\"draft-reset\">${icon('trash')}<span>البدء من جديد</span></button>` : ''}\n          </div>\n        </div></div>`;\n      }\n      if (S.editing && f.existing) {\n        return html`<div class=\"alert alert--info\">${icon('edit')}<div>\n          <strong class=\"alert__title\">أنت تعدّل تقريرًا مُرسلًا</strong>\n          <span class=\"text-sm\">بعد الإرسال يصل التعديل إلى المشرف${f.reviewEnabled ? ' بحالة «بانتظار المراجعة»' : ''}.</span>\n          <div class=\"alert__actions\"><button type=\"button\" class=\"btn btn-secondary btn-sm\" data-action=\"cancel-edit\">${icon('x')}<span>إلغاء التعديل</span></button></div>\n        </div></div>`;\n      }\n      if (S.draftRestored) {\n        return html`<div class=\"alert alert--info\" id=\"sc-draft-note\">${icon('refresh')}<div>\n          <strong class=\"alert__title\">استعدنا ما كتبته سابقًا</strong>\n          <span class=\"text-sm\">بياناتك محفوظة على هذا الجهاز حتى ترسل التقرير.</span>\n          <div class=\"alert__actions\"><button type=\"button\" class=\"btn btn-ghost btn-sm\" data-action=\"draft-reset\">${icon('trash')}<span>البدء من جديد</span></button></div>\n        </div></div>`;\n      }\n      return '';\n    }\n\n    function formViewHtml() {\n      var list = fields();\n      if (!list.length) {\n        return html`<section class=\"card\"><div class=\"empty\">${icon('form')}<h2>النموذج غير جاهز</h2><p>لم يُجهّز المشرف أسئلة التقرير بعد. تواصل مع المشرف.</p></div></section>`;\n      }\n      var pair = lessonsPair();\n      var pairDone = false;\n      var sections = [];\n      list.forEach(function (f) {\n        if (pair && (f === pair.p || f === pair.d)) {\n          if (!pairDone) { sections.push(lessonsSectionHtml(pair)); pairDone = true; }\n          return;\n        }\n        sections.push(fieldSectionHtml(f));\n      });\n      sections.push(filledBySectionHtml());\n      return html`${formNoticeHtml()}<div class=\"sc-form stack\" id=\"sc-form\">${sections}</div>`;\n    }\n\n    function barHtml() {\n      return html`<div class=\"sc-bar\" id=\"sc-bar\">\n        <div class=\"sc-bar__progress\" aria-hidden=\"true\"><span id=\"sc-progress\"></span></div>\n        <div class=\"sc-bar__inner\">\n          <p class=\"sc-bar__note\" id=\"sc-bar-note\"></p>\n          <button type=\"button\" class=\"btn btn-primary btn-lg btn-block\" id=\"sc-submit\" data-action=\"submit\">${icon('send')}<span>${submitLabel()}</span></button>\n        </div>\n      </div>`;\n    }\n    function submitLabel() {\n      if (S.correcting) return 'إرسال التصحيح';\n      if (S.form.state === 'backfill' && !S.form.existing) return 'إرسال تقرير يوم ' + App.date.dayName(S.form.date);\n      if (S.editing && S.form.existing) return 'إرسال التعديل';\n      return 'إرسال التقرير';\n    }\n\n    function closedHtml() {\n      return html`<section class=\"card\"><div class=\"empty empty--warn\">\n        ${icon('clock')}\n        <h2>انتهى وقت الإرسال لهذا اليوم</h2>\n        <p>كان آخر موعد لإرسال التقرير ${App.time.fmt(S.form.deadline)}. إذا احتجت إلى إرسال التقرير فتواصل مع المشرف.</p>\n      </div></section>`;\n    }\n    function offdayHtml() {\n      var f = S.form;\n      return html`<section class=\"card\"><div class=\"empty\">\n        ${icon('calendar')}\n        <h2>${f.isHoliday ? 'اليوم إجازة' : 'اليوم ليس من أيام الدوام'}</h2>\n        <p>لا يلزم إرسال تقرير المتابعة اليوم. نراك في يوم الدوام القادم.</p>\n        <button type=\"button\" class=\"btn btn-secondary\" data-action=\"offday-fill\">${icon('form')}<span>إرسال تقرير على أي حال</span></button>\n      </div></section>`;\n    }\n\n    /* ========================================================= RECEIPT VIEW */\n    function fmtAnswer(f, v) {\n      if (v === null || v === undefined || v === '') return '';\n      if (f.type === 'yesno') return v === true ? 'نعم' : (v === false ? 'لا' : '');\n      if (f.type === 'number') return isNum(v) ? App.fmt.num(v) : str(v);\n      return str(v);\n    }\n    function receiptSummaryHtml(r) {\n      var a = r.answers || {};\n      var d = r.derived || {};\n      var parts = [];\n      var kv = [];\n      var pair = lessonsPair();\n      var pairShown = false;\n      var flushKv = function () {\n        if (kv.length) { parts.push(html`<dl class=\"sc-kv\">${kv}</dl>`); kv = []; }\n      };\n      fields().forEach(function (f) {\n        if (pair && (f === pair.p || f === pair.d)) {\n          if (pairShown) return;\n          pairShown = true;\n          flushKv();\n          var L = d.lessons || {};\n          var planned = isNum(L.planned) ? L.planned : a[pair.p.id];\n          var done = isNum(L.done) ? L.done : a[pair.d.id];\n          if (!isNum(planned) && !isNum(done)) return;\n          var pct = isNum(L.activationPct) ? L.activationPct : (isNum(planned) && planned > 0 && isNum(done) ? Math.round(done / planned * 1000) / 10 : null);\n          parts.push(html`<div><h3 class=\"sc-sec-title\">تفعيل الحصص الدراسية</h3><div class=\"sc-stats\">\n            <div class=\"sc-stat\"><b class=\"num\">${App.fmt.num(planned)}</b><span>المخطط لها</span></div>\n            <div class=\"sc-stat\"><b class=\"num\">${App.fmt.num(done)}</b><span>المفعّلة</span></div>\n            <div class=\"sc-stat sc-stat--ok\"><b class=\"num\">${App.fmt.pct(pct)}</b><span>نسبة التفعيل</span></div>\n          </div></div>`);\n          return;\n        }\n        var v = a[f.id];\n        if (f.type === 'attendance') {\n          var att = d.attendance || {};\n          var rows = attRows(f).filter(function (rr) { return att[rr] || (v && v[rr]); });\n          if (!rows.length) return;\n          flushKv();\n          parts.push(html`<div class=\"sc-att-sum\"><h3 class=\"sc-sec-title\">${f.label}</h3><div class=\"table-wrap\"><table class=\"table\">\n            <thead><tr><th scope=\"col\">الفئة</th><th scope=\"col\" class=\"num\">الحاضرون</th><th scope=\"col\" class=\"num\">الغائبون</th><th scope=\"col\" class=\"num\">نسبة الغياب</th></tr></thead>\n            <tbody>${rows.map(function (rr) {\n              var c = att[rr] || (v && v[rr]) || {};\n              var total = (c.present || 0) + (c.absent || 0);\n              var pct = isNum(c.absencePct) ? c.absencePct : (total > 0 ? Math.round(c.absent / total * 1000) / 10 : null);\n              return html`<tr><th scope=\"row\">${ATT_LABEL[rr]}</th><td class=\"num\">${App.fmt.num(c.present)}</td><td class=\"num\">${App.fmt.num(c.absent)}</td><td class=\"num\">${App.fmt.pct(pct)}</td></tr>`;\n            })}</tbody></table></div></div>`);\n          return;\n        }\n        if (f.type === 'photos') {\n          var ph = Array.isArray(v) ? v : [];\n          if (!ph.length) return;\n          flushKv();\n          parts.push(html`<div><h3 class=\"sc-sec-title\">${f.label} (${photosWord(ph.length)})</h3><div class=\"gallery\">${ph.map(function (p, i) {\n            return html`<button type=\"button\" class=\"sc-gal sc-loading\" data-action=\"view-photo\" data-id=\"${p.id}\" aria-label=\"عرض الصورة ${i + 1}\"><img alt=\"\" data-photo-id=\"${p.id}\"></button>`;\n          })}</div></div>`);\n          return;\n        }\n        var text = fmtAnswer(f, v);\n        if (!text) return;\n        var long = f.type === 'textarea' || text.length > 40;\n        var userText = f.type === 'text' || f.type === 'textarea' || f.type === 'select';\n        kv.push(html`<div class=\"${long ? 'is-block' : ''}\"><dt>${f.label}</dt><dd class=\"${long ? 'is-long' : ''}\"${userText ? App.raw(' dir=\"auto\"') : ''}>${text}</dd></div>`);\n      });\n      flushKv();\n      if (!parts.length) parts.push(html`<p class=\"text-muted text-center\">لا توجد بيانات في هذا التقرير.</p>`);\n      return parts;\n    }\n\n    function receiptHtml() {\n      var f = S.form;\n      var r = f.existing;\n      var st = r.status;\n      var autoApproved = st === 'approved' && !r.reviewedAt && !f.reviewEnabled;\n      var head;\n      if (st === 'returned') {\n        head = html`<div class=\"sc-check sc-check--danger\">${icon('undo')}</div>\n          <h2 class=\"sc-receipt__title\" id=\"sc-receipt-title\" tabindex=\"-1\">أعاد المشرف التقرير للتصحيح</h2>\n          <p class=\"sc-receipt__sub\">راجع ملاحظة المشرف أعلاه ثم اضغط «تصحيح التقرير».</p>`;\n      } else if (st === 'approved' && !autoApproved) {\n        head = html`<div class=\"sc-check${S.justSent ? ' anim-pop is-new' : ''}\">${icon('check-double')}</div>\n          <h2 class=\"sc-receipt__title\" id=\"sc-receipt-title\" tabindex=\"-1\">تم اعتماد التقرير ✓</h2>\n          <p class=\"sc-receipt__sub\">اعتمد المشرف تقرير هذا اليوم. شكرًا لك.</p>`;\n      } else {\n        head = html`<div class=\"sc-check${S.justSent ? ' anim-pop is-new' : ''}\">${icon('check')}</div>\n          <h2 class=\"sc-receipt__title\" id=\"sc-receipt-title\" tabindex=\"-1\">تم إرسال التقرير ✓</h2>\n          <p class=\"sc-receipt__sub\">${autoApproved ? 'وصل التقرير إلى المشرف.' : 'بانتظار مراجعة المشرف'}</p>`;\n      }\n      var badges = [];\n      if (r.late) badges.push(html`<span class=\"badge badge--warn\">${icon('clock')}<span>متأخر</span></span>`);\n      if (r.edits > 0) badges.push(html`<span class=\"badge\">${icon('edit')}<span>عُدِّل ${editsWord(r.edits)}</span></span>`);\n      var meta = [];\n      if (r.submittedAt) meta.push(html`<span>وقت الإرسال: <b class=\"num\">${tsLabel(r.submittedAt, f.date)}</b></span>`);\n      if (r.updatedAt && r.updatedAt !== r.submittedAt) meta.push(html`<span>آخر تعديل: <b class=\"num\">${tsLabel(r.updatedAt, f.date)}</b></span>`);\n      if (st === 'approved' && r.reviewedAt) meta.push(html`<span>وقت الاعتماد: <b class=\"num\">${tsLabel(r.reviewedAt, f.date)}</b></span>`);\n      if (r.filledBy) meta.push(html`<span>المعبّئ: <b><bdi>${r.filledBy}</bdi></b></span>`);\n\n      var actions = [];\n      var note = '';\n      var pastCorrection = f.state === 'correction' || f.state === 'backfill';\n      if (st !== 'returned') {\n        if (f.canEdit && !pastCorrection) actions.push(html`<button type=\"button\" class=\"btn btn-secondary\" data-action=\"edit\">${icon('edit')}<span>تعديل التقرير</span></button>`);\n        actions.push(html`<button type=\"button\" class=\"btn btn-ghost\" data-action=\"copy-receipt\">${icon('copy')}<span>نسخ الإيصال</span></button>`);\n        if (pastCorrection) {\n          actions.unshift(html`<button type=\"button\" class=\"btn btn-primary\" data-action=\"back-today\">${icon('chevron-right')}<span>العودة إلى تقرير اليوم</span></button>`);\n        }\n        if (st === 'approved' && !autoApproved) note = html`<p class=\"sc-receipt__note\">${icon('lock')}<span>لا يمكن تعديل التقرير بعد اعتماده.</span></p>`;\n        else if (f.canEdit && !pastCorrection) note = html`<p class=\"sc-receipt__note\">${icon('info')}<span>${f.reviewEnabled ? 'يمكنك تعديل التقرير ما دام بانتظار مراجعة المشرف.' : 'يمكنك تعديل التقرير إذا لزم الأمر.'}</span></p>`;\n        else if (!pastCorrection) note = html`<p class=\"sc-receipt__note\">${icon('clock')}<span>انتهى وقت التعديل لهذا اليوم.</span></p>`;\n      }\n      return html`<section class=\"card sc-receipt${st === 'returned' ? ' sc-receipt--returned' : ''}${S.justSent ? ' anim-fade-up' : ''}\" id=\"sc-receipt\">\n        <div class=\"sc-receipt__head\">\n          ${head}\n          ${badges.length ? html`<div class=\"sc-receipt__badges\">${badges}</div>` : ''}\n          <p class=\"sc-receipt__meta\">${meta}</p>\n        </div>\n        <div class=\"sc-receipt__body\">${receiptSummaryHtml(r)}</div>\n        ${actions.length || note ? html`<div class=\"sc-receipt__foot\">${actions.length ? html`<div class=\"row\">${actions}</div>` : ''}${note}</div>` : ''}\n      </section>`;\n    }\n\n    function receiptText() {\n      var f = S.form, r = f.existing;\n      var a = r.answers || {}, d = r.derived || {};\n      var L = [];\n      L.push('إيصال تقرير المتابعة اليومي');\n      L.push('المدرسة: ' + (r.schoolName || (f.school && f.school.name) || ''));\n      L.push('التاريخ: ' + App.date.full(f.date));\n      L.push('الحالة: ' + App.status.label(r.status));\n      if (r.submittedAt) L.push('وقت الإرسال: ' + tsLabel(r.submittedAt, f.date) + (r.late ? ' (متأخر)' : ''));\n      if (r.edits > 0) L.push('مرات التعديل: ' + r.edits);\n      var pair = lessonsPair();\n      fields().forEach(function (fl) {\n        var v = a[fl.id];\n        if (fl.type === 'attendance') {\n          attRows(fl).forEach(function (rr) {\n            var c = (d.attendance && d.attendance[rr]) || (v && v[rr]);\n            if (!c) return;\n            var total = (c.present || 0) + (c.absent || 0);\n            var pct = isNum(c.absencePct) ? c.absencePct : (total ? Math.round(c.absent / total * 1000) / 10 : null);\n            L.push(ATT_LABEL[rr] + ': الحاضرون ' + App.fmt.num(c.present) + ' • الغائبون ' + App.fmt.num(c.absent) + ' • نسبة الغياب ' + App.fmt.pct(pct));\n          });\n          return;\n        }\n        if (fl.type === 'photos') {\n          if (Array.isArray(v) && v.length) L.push(fl.label + ': ' + photosWord(v.length));\n          return;\n        }\n        var t = fmtAnswer(fl, v);\n        if (t) L.push(fl.label + ': ' + t);\n        if (pair && fl === pair.d && d.lessons && isNum(d.lessons.activationPct)) {\n          L.push('غير المفعّلة: ' + App.fmt.num(d.lessons.notActivated) + ' • نسبة التفعيل: ' + App.fmt.pct(d.lessons.activationPct));\n        }\n      });\n      if (r.filledBy) L.push('المعبّئ: ' + r.filledBy);\n      L.push('— ' + ((f.systemTitle || BOOT.systemTitle || '') + ' | ' + APP_NAME).replace(/^ \\| /, ''));\n      return L.join('\\n');\n    }\n\n    /* ============================================================== RENDER */\n    function render() {\n      var main;\n      var showBar = false;\n      if (S.view === 'loading') main = skeletonHtml();\n      else if (S.view === 'error') main = errorHtml(S.viewError);\n      else if (S.view === 'picker') main = pickerHtml();\n      else {\n        var parts = [dateCardHtml(), topAlertsHtml(), returnedBannersHtml(), backfillHtml()];\n        if (S.view === 'receipt') parts.push(receiptHtml());\n        else if (S.view === 'closed') parts.push(closedHtml());\n        else if (S.view === 'offday') parts.push(offdayHtml());\n        else { parts.push(formViewHtml()); showBar = fields().length > 0; }\n        main = parts;\n      }\n      App.render(root, html`${heroHtml()}<main class=\"container-narrow sc-main\" id=\"main\">${main}</main>${footerHtml()}${showBar ? barHtml() : ''}`);\n      doc.body.classList.toggle('sc-has-bar', showBar);\n      if (S.view === 'form') afterFormRender();\n      if (S.view === 'receipt') hydratePhotos(root);\n      S.justSent = false;\n    }\n\n    function setView(v) {\n      S.view = v;\n      render();\n    }\n\n    /* ======================================================= FORM LIFECYCLE */\n    function decideView() {\n      var f = S.form;\n      if (S.editing) return 'form';\n      if (f.existing && !f.preview) return 'receipt';\n      if ((!f.isWorkday || f.isHoliday) && !f.preview && !S.offdayOverride) return 'offday';   // before «closed»: nothing is due today\n      if (f.state === 'closed') return 'closed';\n      return 'form';\n    }\n\n    function loadForm(form, opts) {\n      var o = opts || {};\n      S.form = form;\n      S.serverError = '';\n      S.showErrors = false;\n      S.errors = {};\n      S.draftRestored = false;\n      S.clock = { server: hhmmToMin(form.now) || 0, client: Date.now() };\n      S.correcting = form.state === 'correction';\n      S.editing = S.correcting;\n      S.correctionNote = S.correcting && form.existing ? str(form.existing.reviewNote) : '';\n      if (!o.keepOffday) S.offdayOverride = false;\n      var v = decideView();\n      if (v === 'form') initFormState();\n      setView(v);\n      if (!o.noScroll) window.scrollTo(0, 0);\n    }\n\n    /** Builds the working copy of the answers: existing report → draft → empty. */\n    function initFormState() {\n      var f = S.form;\n      var src = S.editing && f.existing ? clone(f.existing.answers || {}) : {};\n      var filled = S.editing && f.existing ? str(f.existing.filledBy) : '';\n      if (!filled) filled = str(App.store.get('filledBy:' + S.token, '') || '');\n      var auto = {};\n      var draft = isPreview() ? null : App.store.get(storeKeyDraft(), null);\n      var base = f.existing ? str(f.existing.updatedAt || 'x') : '';\n      var restored = false;\n      if (draft && typeof draft === 'object' && draft.v === 1 && draft.base === base && draft.answers) {\n        src = draft.answers;\n        if (typeof draft.filledBy === 'string') filled = draft.filledBy;\n        auto = draft.auto && typeof draft.auto === 'object' ? draft.auto : {};\n        restored = true;\n      }\n      S.answers = {};\n      S.att = {};\n      S.auto = {};\n      S.photos = {};\n      S.dirty = false;\n      fields().forEach(function (fl) {\n        var v = src[fl.id];\n        if (fl.type === 'number') S.answers[fl.id] = isNum(v) ? v : toCount(v);\n        else if (fl.type === 'text' || fl.type === 'textarea') S.answers[fl.id] = typeof v === 'string' ? v : '';\n        else if (fl.type === 'select') S.answers[fl.id] = typeof v === 'string' && (fl.options || []).indexOf(v) >= 0 ? v : null;\n        else if (fl.type === 'yesno') S.answers[fl.id] = v === true || v === false ? v : null;\n        else if (fl.type === 'attendance') {\n          attRows(fl).forEach(function (r) {\n            var c = v && typeof v === 'object' && v[r] ? v[r] : {};\n            S.att[r] = { present: toCount(c.present), absent: toCount(c.absent) };\n            S.auto[r] = !!auto[r] && isNum(S.att[r].present);\n          });\n        } else if (fl.type === 'photos') {\n          S.photos[fl.id] = (Array.isArray(v) ? v : []).filter(function (p) { return p && typeof p.id === 'string'; })\n            .slice(0, maxPhotos(fl)).map(function (p) {\n              return { key: App.uid('ph'), status: 'done', photo: { id: p.id, name: str(p.name), w: p.w || 0, h: p.h || 0, size: p.size || 0 }, url: photoUrlCache[p.id] || '' };\n            });\n        }\n      });\n      S.filledBy = filled;\n      if (restored) {\n        var meaningful = hasMeaningfulAnswers();\n        S.draftRestored = meaningful && !f.existing;\n        if (meaningful && f.existing) setTimeout(function () { App.toast('استعدنا تعديلاتك التي لم تُرسل بعد', 'info'); }, 300);\n      }\n    }\n\n    function hasMeaningfulAnswers() {\n      var any = false;\n      fields().forEach(function (fl) {\n        var v = S.answers[fl.id];\n        if (fl.type === 'attendance') { attRows(fl).forEach(function (r) { if (S.att[r] && (isNum(S.att[r].present) || isNum(S.att[r].absent))) any = true; }); }\n        else if (fl.type === 'photos') { if ((S.photos[fl.id] || []).length) any = true; }\n        else if (v !== null && v !== undefined && v !== '') any = true;\n      });\n      return any;\n    }\n\n    function afterFormRender() {\n      var af = attField();\n      if (af) attRows(af).forEach(function (r) { updateAttRow(r); });\n      if (lessonsPair()) updateLessons();\n      fields().forEach(function (fl) {\n        if (fl.type === 'text' || fl.type === 'textarea') updateCounter(fl.id);\n        if (fl.type === 'textarea') autoGrow(doc.getElementById('in-' + fl.id));\n        if (fl.type === 'photos') { paintThumbs(fl.id); hydratePhotos(doc.getElementById('up-' + fl.id)); }\n      });\n      if (S.showErrors) applyErrors(validateAll(), false);\n      refreshStatus();\n    }\n\n    /* ---------------------------------------------------------- the answers */\n    function buildAnswers() {\n      var out = {};\n      fields().forEach(function (fl) {\n        if (fl.type === 'attendance') {\n          var o = {};\n          attRows(fl).forEach(function (r) {\n            var c = S.att[r] || {};\n            o[r] = { present: isNum(c.present) ? c.present : null, absent: isNum(c.absent) ? c.absent : null };\n          });\n          out[fl.id] = o;\n        } else if (fl.type === 'photos') {\n          out[fl.id] = (S.photos[fl.id] || []).filter(function (it) { return it.status === 'done' && it.photo; })\n            .map(function (it) { return { id: it.photo.id, name: it.photo.name, w: it.photo.w, h: it.photo.h, size: it.photo.size }; });\n        } else if (fl.type === 'text' || fl.type === 'textarea') {\n          out[fl.id] = str(S.answers[fl.id]).trim();\n        } else {\n          var v = S.answers[fl.id];\n          out[fl.id] = v === undefined ? null : v;\n        }\n      });\n      return out;\n    }\n\n    /* ---------------------------------------------------------- validation */\n    function validateField(fl) {\n      if (fl.type === 'number') {\n        var n = S.answers[fl.id];\n        if (!isNum(n)) return fl.required ? { msg: 'أدخل العدد.' } : null;\n        var b = numBounds(fl);\n        if (n < b.min) return { msg: 'أقل قيمة مسموحة ' + App.fmt.num(b.min) + '.' };\n        if (n > b.max) return { msg: 'أكبر قيمة مسموحة ' + App.fmt.num(b.max) + '.' };\n        var pair = lessonsPair();\n        if (pair && fl === pair.d && isNum(S.answers[pair.p.id]) && n > S.answers[pair.p.id]) {\n          return { msg: 'أكبر من عدد الحصص المخطط لها.' };\n        }\n        return null;\n      }\n      if (fl.type === 'text' || fl.type === 'textarea') {\n        var s = str(S.answers[fl.id]).trim();\n        var max = fl.type === 'textarea' ? MAX_AREA : MAX_TEXT;\n        if (!s) return fl.required ? { msg: 'اكتب الإجابة.' } : null;\n        if (s.length > max) return { msg: 'النص أطول من المسموح (' + max + ' حرف).' };\n        return null;\n      }\n      if (fl.type === 'select') return fl.required && !S.answers[fl.id] ? { msg: 'اختر إجابة.' } : null;\n      if (fl.type === 'yesno') return fl.required && S.answers[fl.id] !== true && S.answers[fl.id] !== false ? { msg: 'اختر «نعم» أو «لا».' } : null;\n      if (fl.type === 'attendance') {\n        var rows = attRows(fl);\n        for (var i = 0; i < rows.length; i++) {\n          var r = rows[i], c = S.att[r] || {};\n          var p = isNum(c.present), a = isNum(c.absent);\n          var bad = [];\n          if (!p && !a) {\n            if (fl.required) return { msg: 'أدخل عدد الحاضرين والغائبين لفئة ' + ATT_LABEL[r] + '.', bad: ['att-' + r + '-absent', 'att-' + r + '-present'] };\n            continue;\n          }\n          if (!p) bad.push('att-' + r + '-present');\n          if (!a) bad.push('att-' + r + '-absent');\n          if (bad.length) return { msg: 'أكمل عدد ' + (!p ? 'الحاضرين' : 'الغائبين') + ' لفئة ' + ATT_LABEL[r] + '.', bad: bad };\n          if (c.present > MAX_COUNT || c.absent > MAX_COUNT) return { msg: 'الأرقام في فئة ' + ATT_LABEL[r] + ' يجب أن تكون من 0 إلى 100000.', bad: ['att-' + r + '-present', 'att-' + r + '-absent'] };\n          if (fl.required && c.present + c.absent === 0) return { msg: 'مجموع الحاضرين والغائبين لفئة ' + ATT_LABEL[r] + ' لا يمكن أن يكون صفرًا.', bad: ['att-' + r + '-present', 'att-' + r + '-absent'] };\n        }\n        return null;\n      }\n      if (fl.type === 'photos') {\n        var done = (S.photos[fl.id] || []).filter(function (it) { return it.status === 'done'; }).length;\n        return fl.required && !done ? { msg: 'أرفق صورة واحدة على الأقل.' } : null;\n      }\n      return null;\n    }\n    function validateFilledBy() {\n      var s = S.filledBy.trim();\n      if (s.length < 2) return { msg: s ? 'اكتب الاسم كاملًا (حرفان على الأقل).' : 'اكتب اسم من يعبّئ التقرير.' };\n      if (s.length > 80) return { msg: 'الاسم أطول من 80 حرفًا.' };\n      return null;\n    }\n    function validateAll() {\n      var errs = {};\n      fields().forEach(function (fl) { var e = validateField(fl); if (e) errs[fl.id] = e; });\n      var fe = validateFilledBy();\n      if (fe) errs[FILLED] = fe;\n      return errs;\n    }\n    function applyErrors(errs, scroll) {\n      S.errors = errs;\n      $$('.field[data-fid]', root).forEach(function (el) {\n        var id = el.getAttribute('data-fid');\n        setFieldError(id, errs[id] || null);\n      });\n      if (!scroll) return;\n      var first = null;\n      $$('.field[data-fid]', root).some(function (el) { if (errs[el.getAttribute('data-fid')]) { first = el; return true; } return false; });\n      if (first) {\n        var section = first.closest('.sc-q') || first;\n        scrollToEl(section, 'center');\n        var e = errs[first.getAttribute('data-fid')];\n        var target = (e.bad && e.bad.length && doc.getElementById(e.bad[0])) ||\n          first.querySelector('input:not([type=\"file\"]):not([disabled]), textarea, select, .choice, .uploader__drop input');\n        setTimeout(function () { focusNoScroll(target); }, 350);\n        section.classList.remove('sc-flash');\n        void section.offsetWidth;\n        section.classList.add('sc-flash');\n      }\n    }\n    function setFieldError(id, e) {\n      var field = $('.field[data-fid=\"' + id + '\"]', root);\n      var er = doc.getElementById('er-' + id);\n      if (!field || !er) return;\n      field.classList.toggle('has-error', !!e);\n      er.classList.toggle('is-on', !!e);\n      er.querySelector('span').textContent = e ? e.msg : '';\n      $$('input, textarea, select', field).forEach(function (inp) {\n        if (inp.type === 'file') return;\n        var bad = !!e && (!e.bad || e.bad.indexOf(inp.id) >= 0);\n        if (bad) inp.setAttribute('aria-invalid', 'true'); else inp.removeAttribute('aria-invalid');\n      });\n    }\n    function revalidate(id) {\n      if (!S.showErrors && !S.errors[id]) return;\n      var e = id === FILLED ? validateFilledBy() : (fieldById(id) ? validateField(fieldById(id)) : null);\n      if (e) S.errors[id] = e; else delete S.errors[id];\n      setFieldError(id, e);\n      var pair = lessonsPair();\n      if (pair && (id === pair.p.id || id === pair.d.id)) {\n        var other = id === pair.p.id ? pair.d : pair.p;\n        if (S.showErrors || S.errors[other.id]) {\n          var e2 = validateField(other);\n          if (e2) S.errors[other.id] = e2; else delete S.errors[other.id];\n          setFieldError(other.id, e2);\n        }\n      }\n    }\n\n    /* ---------------------------------------------------- live UI updates */\n    function isComplete(fl) {\n      if (fl.type === 'attendance') {\n        return attRows(fl).every(function (r) { var c = S.att[r] || {}; return isNum(c.present) && isNum(c.absent) && (c.present + c.absent > 0 || !fl.required); });\n      }\n      if (fl.type === 'photos') return (S.photos[fl.id] || []).some(function (it) { return it.status === 'done'; });\n      if (fl.type === 'text' || fl.type === 'textarea') return str(S.answers[fl.id]).trim().length > 0;\n      var v = S.answers[fl.id];\n      return v !== null && v !== undefined && v !== '';\n    }\n    function refreshStatus() {\n      var list = fields();\n      var pair = lessonsPair();\n      var total = 0, done = 0;\n      list.forEach(function (fl) {\n        var ok = isComplete(fl) && !validateField(fl);\n        if (fl.required) { total++; if (ok) done++; }\n        if (pair && (fl === pair.p || fl === pair.d)) return;\n        var sec = doc.getElementById('q-' + fl.id);\n        if (sec) sec.classList.toggle('is-done', ok);\n      });\n      if (pair) {\n        var lsec = doc.getElementById('q-lessons');\n        if (lsec) lsec.classList.toggle('is-done', isComplete(pair.p) && isComplete(pair.d) && !validateField(pair.p) && !validateField(pair.d));\n      }\n      var fbOk = !validateFilledBy();\n      total++; if (fbOk) done++;\n      var fsec = doc.getElementById('q-' + FILLED);\n      if (fsec) fsec.classList.toggle('is-done', fbOk);\n      var bar = doc.getElementById('sc-progress');\n      if (bar) bar.style.width = (total ? Math.round(done / total * 100) : 0) + '%';\n      updateBar();\n    }\n    function uploadsPending() {\n      var n = 0;\n      Object.keys(S.photos).forEach(function (k) {\n        (S.photos[k] || []).forEach(function (it) { if (it.status === 'queued' || it.status === 'compressing' || it.status === 'uploading') n++; });\n      });\n      return n;\n    }\n    function updateBar() {\n      var btn = doc.getElementById('sc-submit');\n      var note = doc.getElementById('sc-bar-note');\n      if (!btn || !note) return;\n      var pending = uploadsPending();\n      var disabled = isPreview() || pending > 0 || S.submitting;\n      btn.disabled = disabled;\n      btn.classList.toggle('is-loading', S.submitting);\n      if (S.submitting) btn.setAttribute('aria-busy', 'true'); else btn.removeAttribute('aria-busy');\n      note.classList.toggle('is-busy', pending > 0 || S.submitting);\n      if (isPreview()) App.render(note, html`${icon('eye')}<span>وضع المعاينة — الإرسال معطّل</span>`);\n      else if (S.submitting) App.render(note, html`<span class=\"spinner\"></span><span>جارٍ إرسال التقرير…</span>`);\n      else if (pending > 0) App.render(note, html`<span class=\"spinner\"></span><span>${pending === 1 ? 'جارٍ رفع صورة' : (pending === 2 ? 'جارٍ رفع صورتين' : 'جارٍ رفع ' + photosWord(pending))}… يتفعّل الإرسال بعد اكتمال الرفع</span>`);\n      else if (S.form.reviewEnabled) App.render(note, html`<span>سيصل التقرير للمشرف بحالة: <b>بانتظار المراجعة</b></span>`);\n      else App.render(note, html`<span>سيصل التقرير إلى المشرف مباشرة</span>`);\n    }\n\n    function updateAttRow(r) {\n      var c = S.att[r] || {};\n      var present = doc.getElementById('att-' + r + '-present');\n      var tag = $('[data-tag=\"' + r + '\"]', root);\n      var chip = $('[data-chip=\"' + r + '\"]', root);\n      var hint = $('[data-hint=\"' + r + '\"]', root);\n      if (present) present.classList.toggle('is-auto', !!S.auto[r]);\n      if (tag) tag.hidden = !S.auto[r];\n      var both = isNum(c.present) && isNum(c.absent);\n      var total = both ? c.present + c.absent : 0;\n      if (chip) {\n        chip.hidden = !(both && total > 0);\n        if (both && total > 0) chip.textContent = 'نسبة الغياب ' + App.fmt.pct(Math.round(c.absent / total * 1000) / 10);\n      }\n      if (hint) {\n        var ref = refCount(r);\n        var show = both && ref > 0 && Math.abs(total - ref) / ref > 0.1;\n        hint.hidden = !show;\n        if (show) hint.querySelector('span').textContent = ATT_LABEL[r] + ': المجموع ' + App.fmt.num(total) + ' يختلف عن العدد المسجّل ' + App.fmt.num(ref) + ' — تأكد من الأرقام.';\n      }\n    }\n    function setAttPresent(r, value, isAuto) {\n      S.att[r].present = value;\n      S.auto[r] = !!isAuto && isNum(value);\n      var el = doc.getElementById('att-' + r + '-present');\n      if (el && doc.activeElement !== el) el.value = isNum(value) ? String(value) : '';\n    }\n    function onAttInput(r, part, value) {\n      if (!S.att[r]) S.att[r] = { present: null, absent: null };\n      var c = S.att[r];\n      c[part] = value;\n      if (part === 'present') {\n        S.auto[r] = false;\n      } else {\n        var ref = refCount(r);\n        if (ref > 0 && (!isNum(c.present) || S.auto[r])) {\n          if (isNum(value) && value <= ref) setAttPresent(r, ref - value, true);\n          else if (S.auto[r]) setAttPresent(r, null, false);\n        }\n      }\n      updateAttRow(r);\n      var af = attField();\n      if (af) revalidate(af.id);\n    }\n\n    function updateLessons() {\n      var pair = lessonsPair();\n      if (!pair) return;\n      var p = S.answers[pair.p.id], d = S.answers[pair.d.id];\n      var calc = doc.getElementById('sc-calc');\n      if (!calc) return;\n      var both = isNum(p) && isNum(d);\n      var bad = both && d > p;\n      calc.classList.toggle('is-bad', bad);\n      doc.getElementById('calc-not').textContent = both && !bad ? App.fmt.num(p - d) : '—';\n      var pct = both && p > 0 && !bad ? Math.round(d / p * 1000) / 10 : null;\n      doc.getElementById('calc-pct').textContent = both && !bad ? App.fmt.pct(pct) : '—';\n      doc.getElementById('calc-bar').style.width = (isNum(pct) ? Math.min(100, pct) : 0) + '%';\n    }\n\n    function updateCounter(id) {\n      var fl = fieldById(id);\n      var ct = doc.getElementById('ct-' + id);\n      if (!fl || !ct) return;\n      var max = fl.type === 'textarea' ? MAX_AREA : MAX_TEXT;\n      var len = str(S.answers[id]).length;\n      ct.hidden = len < max * 0.7;\n      ct.textContent = App.fmt.num(len) + ' / ' + App.fmt.num(max);\n      ct.classList.toggle('is-near', len >= max * 0.9 && len <= max);\n      ct.classList.toggle('is-over', len > max);\n    }\n    function autoGrow(ta) {\n      if (!ta) return;\n      ta.style.height = 'auto';\n      ta.style.height = Math.min(Math.max(ta.scrollHeight + 3, 112), 360) + 'px';\n    }\n\n    /* --------------------------------------------------------------- draft */\n    var saveDraftSoon = App.debounce(saveDraftNow, 450);\n    function saveDraftNow() {\n      if (!S.form || !S.form.ok || isPreview() || S.view !== 'form' || !S.dirty) return;\n      App.store.set(storeKeyDraft(), {\n        v: 1,\n        base: S.form.existing ? str(S.form.existing.updatedAt || 'x') : '',\n        answers: buildAnswers(),\n        filledBy: S.filledBy,\n        auto: S.auto,\n        savedAt: Date.now()\n      });\n    }\n    function markDirty() {\n      S.dirty = true;\n      saveDraftSoon();\n    }\n    function clearDraft() {\n      saveDraftSoon.cancel();\n      App.store.del(storeKeyDraft());\n    }\n    function pruneOldDrafts() {\n      try {\n        var prefix = 'nabd:draft:' + S.token + ':';\n        var limit = App.date.add(App.date.today(), -7);\n        var drop = [];\n        for (var i = 0; i < window.localStorage.length; i++) {\n          var k = window.localStorage.key(i);\n          if (k && k.indexOf(prefix) === 0 && k.slice(prefix.length) < limit) drop.push(k);\n        }\n        drop.forEach(function (k) { window.localStorage.removeItem(k); });\n      } catch (e) { /* storage unavailable */ }\n    }\n\n    /* ============================================================== PHOTOS */\n    function uploaderInner(fl) {\n      var items = S.photos[fl.id] || [];\n      var max = maxPhotos(fl);\n      var full = items.length >= max;\n      var disabled = isPreview();\n      var dis = disabled ? App.raw(' disabled') : '';\n      var parts = [];\n      if (!items.length) {\n        parts.push(html`<div class=\"sc-up-zone\"><label class=\"uploader__drop${disabled ? ' is-disabled' : ''}\"${disabled ? App.raw(' aria-disabled=\"true\"') : ''}>\n          ${icon('camera')}\n          <span>${disabled ? 'رفع الصور معطّل في وضع المعاينة' : 'اضغط لإضافة صور الشواهد'}</span>\n          <small class=\"uploader__hint\">من المعرض أو الكاميرا${fl.help ? '' : ' • حتى ' + photosWordG(max)}</small>\n          <input type=\"file\" accept=\"image/*\" multiple data-kind=\"file\" data-fid=\"${fl.id}\" aria-label=\"اختيار صور الشواهد\"${dis}>\n        </label></div>`);\n      } else {\n        parts.push(html`<div class=\"uploader__grid\">${items.map(function (it, i) { return thumbHtml(fl, it, i); })}${!full ? html`<label class=\"sc-add-tile${disabled ? ' is-disabled' : ''}\">${icon('plus')}<span>إضافة</span>\n            <input type=\"file\" accept=\"image/*\" multiple data-kind=\"file\" data-fid=\"${fl.id}\" aria-label=\"إضافة صور أخرى\"${dis}></label>` : ''}</div>`);\n      }\n      var pending = items.filter(function (it) { return it.status !== 'done' && it.status !== 'error'; }).length;\n      var errors = items.filter(function (it) { return it.status === 'error'; }).length;\n      var noteTxt = pending ? 'جارٍ الرفع…' : (errors ? 'تعذّر رفع ' + photosWordG(errors) : (items.length ? App.fmt.num(items.length) + ' من ' + App.fmt.num(max) : ''));\n      var cam = COARSE && !full && !disabled\n        ? html`<label class=\"btn btn-secondary btn-sm sc-file-btn\">${icon('camera')}<span>التقاط صورة</span><input type=\"file\" accept=\"image/*\" capture=\"environment\" data-kind=\"file\" data-fid=\"${fl.id}\" aria-label=\"التقاط صورة بالكاميرا\"></label>`\n        : html`<span></span>`;\n      if (cam || noteTxt) parts.push(html`<div class=\"uploader__actions\">${cam}<span class=\"sc-up-note${pending ? ' is-busy' : ''}\" aria-live=\"polite\">${noteTxt}</span></div>`);\n      return parts;\n    }\n    function thumbHtml(fl, it, i) {\n      var n = i + 1;\n      var cls = 'thumb';\n      if (it.status === 'queued' || it.status === 'compressing' || it.status === 'uploading') cls += ' is-uploading';\n      if (it.status === 'error') cls += ' is-error' + (it.payload ? '' : ' sc-fatal');\n      var hasUrl = !!(it.url || it.thumbUrl);\n      if (it.status === 'done' && !hasUrl) cls += ' sc-loading';\n      return html`<div class=\"${cls}\" data-key=\"${it.key}\" title=\"${it.status === 'error' ? it.error || 'تعذّر رفع الصورة' : ''}\">\n        ${hasUrl || (it.status === 'done' && it.photo) ? html`<img alt=\"صورة الشاهد ${n}\" data-key-img=\"${it.key}\"${it.status === 'done' && !hasUrl && it.photo ? html` data-photo-id=\"${it.photo.id}\"` : ''}>` : ''}\n        ${it.status === 'done' ? html`<button type=\"button\" class=\"sc-thumb-open\" data-action=\"photo-view\" data-fid=\"${fl.id}\" data-key=\"${it.key}\" aria-label=\"عرض الصورة ${n}\"></button>` : ''}\n        ${it.status === 'uploading' || it.status === 'compressing' || it.status === 'queued' ? html`<div class=\"progress\" role=\"progressbar\" aria-label=\"تقدّم رفع الصورة ${n}\"><div class=\"progress__bar\" data-progress=\"${it.key}\"></div></div>` : ''}\n        ${it.status === 'error' && it.payload ? html`<button type=\"button\" class=\"thumb__retry\" data-action=\"photo-retry\" data-fid=\"${fl.id}\" data-key=\"${it.key}\">${icon('refresh')}<span>إعادة</span></button>` : ''}\n        ${it.status === 'error' && !it.payload ? html`<span class=\"sc-thumb-err\">صورة غير صالحة</span>` : ''}\n        <button type=\"button\" class=\"thumb__remove\" data-action=\"photo-remove\" data-fid=\"${fl.id}\" data-key=\"${it.key}\" aria-label=\"حذف الصورة ${n}\"${isPreview() ? App.raw(' disabled') : ''}>${icon('x')}</button>\n      </div>`;\n    }\n    function renderUploader(fid) {\n      var box = doc.getElementById('up-' + fid);\n      var fl = fieldById(fid);\n      if (!box || !fl) return;\n      var hadFocus = box.contains(doc.activeElement);\n      App.render(box, html`${uploaderInner(fl)}`);\n      paintThumbs(fid);\n      hydratePhotos(box);\n      if (hadFocus) {\n        var t = box.querySelector('.sc-add-tile input, .uploader__drop input');\n        if (t) focusNoScroll(t);\n      }\n      var sec = doc.getElementById('q-' + fid);\n      if (sec) sec.classList.toggle('is-done', isComplete(fl));\n      refreshStatus();\n    }\n    function paintThumbs(fid) {\n      (S.photos[fid] || []).forEach(function (it) {\n        var img = $('img[data-key-img=\"' + it.key + '\"]', root);\n        var u = it.url || it.thumbUrl;\n        if (img && u) img.src = u;\n        var bar = $('[data-progress=\"' + it.key + '\"]', root);\n        if (bar) bar.style.width = Math.round((it.progress || 0.06) * 100) + '%';\n      });\n    }\n    function findItem(fid, key) {\n      var list = S.photos[fid] || [];\n      for (var i = 0; i < list.length; i++) if (list[i].key === key) return list[i];\n      return null;\n    }\n\n    function addFiles(fid, fileList) {\n      var fl = fieldById(fid);\n      if (!fl || isPreview()) return;\n      var files = Array.prototype.slice.call(fileList || []);\n      if (!files.length) return;\n      var items = S.photos[fid] || (S.photos[fid] = []);\n      var free = maxPhotos(fl) - items.length;\n      if (free <= 0) { App.toast('وصلت إلى الحد الأقصى (' + photosWord(maxPhotos(fl)) + ').', 'info'); return; }\n      if (files.length > free) {\n        App.toast('الحد الأقصى ' + photosWord(maxPhotos(fl)) + ' — أُضيفت ' + photosWord(free) + ' فقط.', 'info', 4200);\n        files = files.slice(0, free);\n      }\n      files.forEach(function (file) { items.push({ key: App.uid('ph'), status: 'queued', file: file, progress: 0.04 }); });\n      if (S.errors[fid]) revalidate(fid);\n      renderUploader(fid);\n      pump();\n    }\n\n    function pump() {\n      var next = null;\n      Object.keys(S.photos).some(function (fid) {\n        return (S.photos[fid] || []).some(function (it) {\n          if (it.status === 'queued') { next = { fid: fid, it: it }; return true; }\n          return false;\n        });\n      });\n      if (!next || activeUploads >= UPLOAD_CONCURRENCY) { updateBar(); return; }\n      activeUploads++;\n      processItem(next.fid, next.it).then(done, done);\n      function done() { activeUploads--; pump(); }\n      pump();\n    }\n\n    function processItem(fid, it) {\n      it.status = 'compressing';\n      it.progress = 0.08;\n      var token = S.token;\n      // 1280 px at q≈0.72 (≈150–250 KB) keeps evidence sharp on screen and in print while the\n      // supervisor's own Drive (15 GB shared with Gmail) lasts for years.\n      var compress = it.payload ? 